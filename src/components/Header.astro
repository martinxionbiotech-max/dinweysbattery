---
import { localeFromPath, localizePath, t, type Locale } from "../i18n/ui";

const pathname = Astro.url.pathname;
const locale: Locale = localeFromPath(pathname);
const prefix = locale === "ar" ? "/ar" : locale === "es" ? "/es" : "";
const p = (href: string) => (href.startsWith("http") || href.startsWith("/") === false ? href : `${prefix}${href}`);

const navItems = [
  { href: "/", key: "nav.home" },
  {
    key: "nav.batteries",
    children: [
      { href: "/products/jis-heavy-duty/", key: "nav.jisHeavy" },
      { href: "/products/din-heavy-duty/", key: "nav.dinHeavy" },
      { href: "/products/bci-request/", key: "nav.bciRequest" },
      { href: "/products/24v/", key: "nav.24v" },
      { href: "/products/fleet/", key: "nav.fleet" },
      { href: "/batteries/", key: "nav.allModels" },
      { href: "/products/", key: "nav.allLines" },
    ],
  },
  {
    key: "nav.compare",
    children: [
      { href: "/compare/", key: "nav.allComparisons" },
      { href: "/compare/n150-vs-n200/", key: "nav.n150vsN200" },
      { href: "/compare/din88-vs-din100/", key: "nav.din88vsDin100" },
      { href: "/compare/jis-vs-din-vs-bci/", key: "nav.jisVsDinVsBci" },
      { href: "/compare/12v-vs-24v/", key: "nav.12vVs24v" },
      { href: "/compare/truck-battery-cca/", key: "nav.howMuchCca" },
    ],
  },
  {
    key: "nav.fitment",
    children: [
      { href: "/truck-models/", key: "nav.truckModels" },
      { href: "/selection-tool/", key: "nav.selectionTool" },
      { href: "/applications/mining-off-highway/", key: "nav.mining" },
      { href: "/applications/cold-chain-refrigerated/", key: "nav.coldChain" },
      { href: "/applications/bus-coach/", key: "nav.busCoach" },
      { href: "/applications/diesel-generator/", key: "nav.dieselGen" },
    ],
  },
  {
    key: "nav.markets",
    children: [
      { href: "/markets/middle-east/", key: "nav.middleEast" },
      { href: "/markets/africa/", key: "nav.africa" },
      { href: "/markets/latin-america/", key: "nav.latinAmerica" },
      { href: "/markets/southeast-asia/", key: "nav.seAsia" },
    ],
  },
  {
    key: "nav.resources",
    children: [
      { href: "https://docs.dinweysbattery.com/", key: "nav.knowledgeBase", external: true },
      { href: "/about/", key: "nav.about" },
    ],
  },
  { href: "/contact/", key: "nav.contact", cta: true },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" || pathname === `${prefix}/` : pathname.startsWith(href) || pathname.startsWith(`${prefix}${href}`);

const langOptions: { code: Locale; label: string }[] = [
  { code: "en", label: "EN" },
  { code: "ar", label: "عربي" },
  { code: "es", label: "ES" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={p("/")} class="brand" aria-label="DINWEY Truck Batteries — Home">
      <img src="/images/logo.png" alt="DINWEY" width="40" height="40" />
      <span class="brand-text">DINWEY<small>Truck &amp; Heavy-Duty Starting Batteries</small></span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {
        navItems.map((item) => {
          if ("children" in item) {
            return (
              <div class="nav-group">
                <button class="nav-group-toggle" aria-haspopup="true" aria-expanded="false">
                  {t(locale, item.key)} ▾
                </button>
                <div class="nav-dropdown" role="menu">
                  {item.children.map((child) => (
                    <a
                      href={p(child.href)}
                      role="menuitem"
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class={isActive(child.href) ? "active" : ""}
                    >
                      {t(locale, child.key)}
                    </a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <a
              href={p(item.href)}
              aria-current={isActive(item.href) ? "page" : undefined}
              class={[
                isActive(item.href) ? "active" : "",
                item.cta ? "nav-cta" : "",
              ].filter(Boolean).join(" ") || undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener" : undefined}
            >
              {t(locale, item.key)}
            </a>
          );
        })
      }
      <div class="lang-switch" role="group" aria-label={t(locale, "lang.label")}>
        {langOptions.map((opt) => (
          <a
            href={localizePath(pathname, opt.code)}
            lang={opt.code}
            hreflang={opt.code}
            class={["lang-link", opt.code === locale ? "lang-active" : ""].filter(Boolean).join(" ")}
            aria-current={opt.code === locale ? "true" : undefined}
          >
            {opt.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: 12px;
  }
  .lang-link {
    font-size: 0.85rem;
    padding: 4px 10px;
    border: 1px solid #d7dee8;
    border-radius: 999px;
    color: #33475b;
    text-decoration: none;
    line-height: 1.4;
  }
  .lang-link:hover {
    border-color: #f5a623;
    color: #0f1f3d;
  }
  .lang-active {
    background: #0f1f3d;
    color: #fff;
    border-color: #0f1f3d;
  }
</style>
