  "datePublished": "2026-09-13",
  "dateModified": "2026-09-13",
  "mainEntityOfPage": { "@type": "WebPage", "@id": SITE + "/ar/compare/jis-vs-din-vs-bci/" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "هل يمكنني مقارنة قيمة CCA وفق JIS بقيمة CCA وفق EN أو SAE؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "لا — تختبر JIS D5301 عند −15°C بينما تختبر EN 50342 وSAE J537 عند −18°C، وتختلف جهود القطع والمدد. تحمل البطارية نفسها رقمًا مختلفًا وفق كل معيار، لذا قارن ضمن معيار واحد فقط."
      }
    },
    {
      "@type": "Question",
      "name": "لماذا تبدو قيمة CCA وفق JIS أعلى من قيمة CCA وفق EN؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "لأن JIS تختبر عند −15°C الأكثر دفئًا مقابل −18°C لاختبار EN/SAE. الاختبار الأكثر دفئًا يجعل البطارية تقدّم تيارًا أكبر، لذا يكون رقم JIS أعلى للبطارية الفيزيائية نفسها — والفرق في الاختبار لا في البطارية."
      }
    },
    {
