---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما معيار البطاريات المستخدم للشاحنات في أمريكا اللاتينية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تتبع أمريكا اللاتينية في الغالب معيار BCI — مقاسا المجموعة 31 و8D — بما يطابق الشاحنات الثقيلة الأمريكية الشمالية، مع ظهور مركبات أوروبية ويابانية أيضًا. طابِق البطارية مع المركبة وقاعدتها."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن لـ DINWEY توريد بطاريات BCI المجموعة 31 و8D؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، تُصنَّع حسب الطلب عبر خط إنتاج BCI لدينا. تحمل مقاسات BCI تصنيفات التدوير البارد وفق SAE J537 (تُختبر عند −18°C)، ونورّدها عند الطلب لأساطيل أمريكا اللاتينية وأمريكا الشمالية."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين مقاسات BCI ومقاسات JIS؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يستخدم BCI أرقام المجموعات (31، 8D) التي يحددها Battery Council International لأمريكا الشمالية وأمريكا اللاتينية، مع اختبار CCA وفق SAE J537 عند −18°C. ويستخدم JIS رموز الطرازات (N150، N200) لآسيا وأفريقيا، باختبار وفق JIS D5301 عند −15°C. وهما غير قابلين للتبادل — طابِق المعيار مع المركبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل تصدّرون البطاريات إلى أمريكا اللاتينية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. توفّر DINWEY بطاريات BCI مجموعة 31/8D عند الطلب، إضافة إلى تخصيص OEM، للمستوردين والموزعين في مختلف أنحاء أمريكا اللاتينية، مع بيانات اختبار لكل دفعة ومستندات شحن كاملة."
      }
    }
  ]
};
---

<BaseLayout
  title="بطاريات الشاحنات لأمريكا اللاتينية — تصنيع OEM من DINWEY"
  description="بطاريات شاحنات للخدمة الشاقة BCI مجموعة 31/8D لمستوردي أمريكا اللاتينية — CCA وفق SAE J537، تُصنَّع حسب الطلب. توريد OEM من Chengguang Power Tech."
  jsonLd={faqJsonLd}
>
  <div class="container section">
    <nav aria-label="مسار التنقل" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/ar/" style="color:#1e5aa8;">الرئيسية</a> &rsaquo; الأسواق &rsaquo; أمريكا اللاتينية
    </nav>
    <h1 style="color:#0f1f3d;">بطاريات الشاحنات للسوق الأمريكية اللاتينية</h1>
    <p class="lead">
      تتبع أمريكا اللاتينية معيار BCI — مقاسا المجموعة 31 و8D بما يطابق الشاحنات الثقيلة الأمريكية
      الشمالية — مع تصنيفات تدوير بارد وفق SAE J537. وتوفّر DINWEY هذه المقاسات عند الطلب، مع
      تخصيص OEM للمستوردين والموزعين.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">النقاط الرئيسية</h2>
    <ol class="takeaways-list">
      <li><strong>BCI مجموعة 31/8D هو المعيار الإقليمي</strong> — بما يطابق الشاحنات الثقيلة الأمريكية الشمالية، وبتصنيف وفق SAE J537 عند −18°C.</li>
      <li><strong>يُصنَّع حسب الطلب</strong> — تُورَّد مقاسات BCI عند الطلب عبر خط إنتاج BCI لدينا، مع تخصيص OEM/العلامة الخاصة.</li>
      <li><strong>المعايير غير قابلة للتبادل</strong> — تختلف أرقام مجموعات BCI عن رموز طرازات JIS ورموز سعة DIN؛ طابِق البطارية مع المركبة وقاعدتها.</li>
      <li><strong>سرعة OEM مهمة</strong> — يقدّر المستوردون سرعة الانتقال من الرسم الفني إلى العيّنة المعتمدة، مع بناء العلامة والتغليف وفق المواصفات.</li>
    </ol>

    <h2 style="color:#0f1f3d;margin-top:32px;">معايير البطاريات في المنطقة</h2>
    <p>
      يهيمن على أسطول الشاحنات الثقيلة في أمريكا اللاتينية الطرازات الأمريكية الشمالية، التي
      تستخدم مقاسات BCI (Battery Council International) — لا سيما المجموعة 31 و8D. ويُختبر CCA
      وفق SAE J537 عند −18°C. كما تظهر مركبات أوروبية ويابانية في بعض الأسواق، لذا قد يحتاج
      المستورد إلى تغطية DIN أو JIS إلى جانب BCI. ويُنتج خط BCI لدى DINWEY حسب الطلب، ليتمكن
      الموزع من تحديد المجموعة 31 أو 8D والحصول على المقاس الدقيق الذي يتطلبه سوقه.
    </p>
    <table>
      <thead>
        <tr><th>المعيار</th><th>الجهة المُصدِرة</th><th>اختبار CCA</th><th>مقاسات الخدمة الشاقة</th></tr>
      </thead>
      <tbody>
        <tr><td>BCI</td><td>Battery Council International</td><td>SAE J537 (−18°C)</td><td>المجموعة 31 / 8D</td></tr>
        <tr><td>JIS</td><td>Japanese Industrial Standards</td><td>JIS D5301 (−15°C)</td><td>N150, N200</td></tr>
        <tr><td>DIN/EN</td><td>Deutsches Institut für Normung</td><td>EN 50342-1 (−18°C)</td><td>DIN88, DIN100</td></tr>
      </tbody>
    </table>

    <h2 style="color:#0f1f3d;margin-top:32px;">OEM والعلامة الخاصة للمنطقة</h2>
    <p>
      يقدّر المستوردون في أمريكا اللاتينية باستمرار سرعة التخصيص — بالانتقال من رسم فني إلى
      عيّنة معتمدة مع بناء العلامة والتغليف ونوع الأقطاب وفق المواصفات. ويغطي برنامج OEM لدى
      DINWEY النطاق الكامل للعلامة الخاصة: العلامة والتغليف والمواصفات ونوع الأقطاب، للموزعين
      والمستوردين والعلامات التجارية حول العالم.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">الاستيراد والامتثال</h2>
    <p>
      تختلف مستندات الاستيراد وأي متطلبات مطابقة من بلد إلى آخر وتتطور بمرور الوقت. تعامل مع
      الأرقام على أنها إرشادية، وتأكد من وضع الشهادات ووسم المنتجات والرسوم الجمركية السائد مع
      المستورد أو وكيل الشحن قبل كل شحنة.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">خطوط المنتجات للمنطقة</h2>
    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h3>BCI مجموعة 31 / 8D</h3>
        <p>مقاسات أمريكية شمالية، تُصنَّع حسب الطلب عبر خط إنتاج BCI لدينا.</p>
        <a href="/ar/products/bci-request/">اعرض BCI (عند الطلب) ←</a>
      </div>
      <div class="card">
        <h3>الأساطيل وتصنيع المعدات الأصلية</h3>
        <p>توريد بالجملة واتساق بين الدفعات وتخصيص العلامة الخاصة للمستوردين.</p>
        <a href="/ar/products/fleet/">اعرض برامج الأساطيل ←</a>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما معيار البطاريات المستخدم للشاحنات في أمريكا اللاتينية؟</h3>
      <p>تتبع أمريكا اللاتينية في الغالب معيار BCI — مقاسا المجموعة 31 و8D — بما يطابق الشاحنات الثقيلة الأمريكية الشمالية، مع ظهور مركبات أوروبية ويابانية أيضًا. طابِق البطارية مع المركبة وقاعدتها.</p>
    </div>
    <div class="faq-item">
      <h3>هل يمكن لـ DINWEY توريد بطاريات BCI المجموعة 31 و8D؟</h3>
      <p>نعم، تُصنَّع حسب الطلب عبر خط إنتاج BCI لدينا. تحمل مقاسات BCI تصنيفات التدوير البارد وفق SAE J537 (تُختبر عند −18°C)، ونورّدها عند الطلب لأساطيل أمريكا اللاتينية وأمريكا الشمالية.</p>
    </div>
    <div class="faq-item">
      <h3>ما الفرق بين مقاسات BCI ومقاسات JIS؟</h3>
      <p>يستخدم BCI أرقام المجموعات (31، 8D) التي يحددها Battery Council International لأمريكا الشمالية وأمريكا اللاتينية، مع اختبار CCA وفق SAE J537 عند −18°C. ويستخدم JIS رموز الطرازات (N150، N200) لآسيا وأفريقيا، باختبار وفق JIS D5301 عند −15°C. وهما غير قابلين للتبادل — طابِق المعيار مع المركبة.</p>
    </div>
    <div class="faq-item">
      <h3>هل تصدّرون البطاريات إلى أمريكا اللاتينية؟</h3>
      <p>نعم. توفّر DINWEY بطاريات BCI مجموعة 31/8D عند الطلب، إضافة إلى تخصيص OEM، للمستوردين والموزعين في مختلف أنحاء أمريكا اللاتينية، مع بيانات اختبار لكل دفعة ومستندات شحن كاملة.</p>
    </div>

    <p style="margin-top:24px;">
      📚 اقرأ المزيد: <a href="https://docs.dinweysbattery.com/jis-vs-din-vs-bci/" target="_blank" rel="noopener">معايير JIS مقابل DIN مقابل BCI</a>
    </p>
  </div>
</BaseLayout>
