const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": SITE + "/ar/" },
    { "@type": "ListItem", "position": 2, "name": "ملاءمة موديلات الشاحنات", "item": SITE + "/ar/truck-models/" },
  ],
};

const faqJsonLd = {
