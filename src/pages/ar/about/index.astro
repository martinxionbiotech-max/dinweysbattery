---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "عن DINWEYS",
  "url": "https://dinweysbattery.com/ar/about/",
  "mainEntity": { "@id": "https://dinweysbattery.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "هل DINWEYS مصنع أم شركة تجارية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DINWEYS هي العلامة التجارية لبطاريات بدء التشغيل للشاحنات والخدمة الشاقة التابعة لشركة Chengguang Power Tech Co., Ltd.، وهي شركة مصنّعة تأسست عام 2002 في مدينة جينتشو بمقاطعة خبي في الصين. وتُنتَج البطاريات من البداية إلى النهاية على خطوط التجميع الآلية الـ18 الخاصة بالشركة، بدلًا من تجميعها من أجزاء موردة من جهات خارجية."
      }
    },
    {
      "@type": "Question",
      "name": "أين تُصنَّع بطاريات DINWEYS؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "في منشأة Chengguang Power Tech Co., Ltd. في مدينة جينتشو، شيجياتشوانغ، مقاطعة خبي، الصين — مصنع بمساحة 200,000 م² يضم 18 خط تجميع آليًا. الأرقام الخاصة بالمنشأة معلنة من الشركة المصنعة وليست مدقّقة من طرف ثالث."
      }
    },
    {
      "@type": "Question",
      "name": "ما الشهادات التي يحملها المصنع؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يعمل المصنع وفق نظام إدارة جودة IATF 16949، وتفيد الشركة المصنعة بحصوله على ISO 9001:2015 وISO 14001:2015 وISO 45001:2018 وOHSAS 18001 وعلامة CE. لم تُنشر أرقام الشهادات وجهات إصدارها ونطاقها على هذا الموقع بعد — اطلبها مع عرض السعر."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدّم DINWEYS إنتاجًا بتصنيع المعدات الأصلية والعلامات الخاصة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. يُعدّ التوريد بتصنيع المعدات الأصلية والعلامات الخاصة جزءًا من نطاق المنتجات؛ حيث يتم الاتفاق على العلامة التجارية والتغليف والوثائق وسجلات اختبار الدفعات لكل برنامج على حدة. أخبرنا بحجم المجموعة وCCA والسوق، وسنقدّم عرض سعر وفق مواصفاتك."
      }
    },
    {
      "@type": "Question",
      "name": "ما أحجام البطاريات التي تنشر DINWEYS مواصفاتها؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "أربعة موديلات منشورة من الشركة نفسها: 145G51 (N150) و190H52 (N200) و58827 (DIN88) و60038 (DIN100). ويُصنَّع BCI مجموعة 31 / 8D حسب الطلب، كما تُدرَج ستة أحجام مجموعات إضافية (N70 وN100 وN120 وN220 وDIN66 وDIN74) كمرجع من طرف ثالث فقط — وليست تصنيفات منشورة لمخزون DINWEYS."
      }
    }
  ]
};
---

<BaseLayout
  title="عن DINWEYS — علامة بطاريات الشاحنات والخدمة الشاقة"
  description="DINWEYS هي العلامة التجارية لبطاريات بدء التشغيل للشاحنات والخدمة الشاقة التابعة لشركة Chengguang Power Tech Co., Ltd.، وهي شركة مصنّعة تأسست عام 2002 في خبي بالصين."
  jsonLd={[aboutJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">عن DINWEYS</h1>
    <p class="lead">
      DINWEYS هي العلامة التجارية لبطاريات بدء التشغيل للشاحنات والخدمة الشاقة التابعة لشركة Chengguang Power Tech Co., Ltd.،
      وهي شركة مصنّعة تأسست عام 2002. نركّز على شيء واحد: بطاريات بدء تشغيل تصمد
      أمام متطلبات الشاحنات التجارية — أمبير تدوير بارد عالٍ، ومقاومة للاهتزاز،
      وجودة متسقة بين الدفعات.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">تركيزنا</h2>
    <p>
      بينما يبيع كثير من موردي البطاريات تشكيلة واسعة، تركّز DINWEYS على قطاع الشاحنات
      والخدمة الشاقة تحديدًا. هذا التركيز يتيح لنا التعمق في ما يهم مشتري المركبات
      التجارية: أحجام المجموعات الصحيحة (JIS N150/N200، وDIN88/DIN100؛ وBCI مجموعة 31/8D عند الطلب)،
      وCCA بمستوى الديزل، ومتطلبات أنظمة 12 فولت مقابل 24 فولت.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">المصنع وراء العلامة التجارية</h2>
    <p>
      تُصنَّع بطاريات DINWEYS بواسطة شركة Chengguang Power Tech Co., Ltd.، وهي شركة مصنّعة للبطاريات تأسست
      عام 2002 في مدينة جينتشو، شيجياتشوانغ، مقاطعة خبي، الصين. يمتد المصنع على مساحة
      200,000 م² ويضم 18 خط تجميع آليًا، ويصدّر إلى أكثر من 70 دولة.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">داخل المصنع</h2>
    <p class="lead" style="margin-bottom:16px;">
      جولة داخل منشأة Chengguang Power Tech Co., Ltd. في جينتشو، خبي — 200,000 م²، و18 خط تجميع
      آلي، وأرضية الإنتاج التي تقف خلف كل بطارية DINWEYS.
    </p>
    <section class="factory-gallery" aria-label="مصنع Chengguang Power Tech Co., Ltd.">
      <div class="factory-slot">
        <img src="/images/factory/factory-01.jpg" alt="مصنع بطاريات Chengguang Power Tech Co., Ltd." width="1200" height="655" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-02.jpg" alt="مصنع بطاريات Chengguang Power Tech Co., Ltd." width="1200" height="499" loading="lazy" decoding="async" />
      </div>
