        <img src="/images/factory/factory-03.jpg" alt="مصنع بطاريات Chengguang Power Tech Co., Ltd." width="1200" height="502" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-04.jpg" alt="مصنع بطاريات Chengguang Power Tech Co., Ltd." width="1200" height="502" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-05.jpg" alt="مصنع بطاريات Chengguang Power Tech Co., Ltd." width="1200" height="503" loading="lazy" decoding="async" />
      </div>
