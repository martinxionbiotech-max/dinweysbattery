---
import BaseLayout from "../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما حجم مجموعة البطارية الذي تحتاجه شاحنتي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تستخدم شاحنات الخدمة الشاقة في الغالب بطاريات JIS N150/N200 (الطرازان 145G51/190H52) أو DIN88/DIN100 حسب السوق. أما مركبات أمريكا الشمالية فتستخدم BCI مجموعة 31 (متاحة عند الطلب). تأكد دائمًا من حجم المجموعة المطبوع على بطاريتك الحالية أو في دليل المركبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل تستخدم شاحنات الخدمة الشاقة أنظمة 12 فولت أم 24 فولت؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تستخدم معظم الشاحنات النصفية والمركبات التجارية الثقيلة أنظمة كهربائية بجهد 24 فولت (بطاريتان 12 فولت موصولتان على التوالي)، بينما تستخدم الشاحنات الخفيفة والبيك أب أنظمة 12 فولت. تحقق من مواصفات مركبتك قبل الطلب."
      }
    },
    {
      "@type": "Question",
      "name": "ما مقدار CCA الذي تحتاجه بطارية شاحنة الديزل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تحتاج محركات الديزل إلى أمبير تدوير بارد (CCA) عالٍ. وتتطلب شاحنات الخدمة الشاقة عادةً 800–1100+ CCA حسب سعة المحرك والمناخ. كلما كان المناخ أبرد، زادت الحاجة إلى CCA. أكد المتطلب الدقيق في دليل مركبتك."
      }
    },
    {
      "@type": "Question",
      "name": "هل تقدّمون بطاريات شاحنات بتصنيع المعدات الأصلية والعلامات الخاصة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. بصفتنا علامة DINWEYS التابعة لشركة Chengguang Power Tech Co., Ltd. (تأسست عام 2002)، نصنّع بطاريات بدء تشغيل الشاحنات لبرامج تصنيع المعدات الأصلية والعلامات الخاصة، بما في ذلك العلامة التجارية والتغليف والمواصفات المخصصة."
      }
    }
  ]
};
---

<BaseLayout
  title="DINWEYS | بطاريات بدء التشغيل للشاحنات والخدمة الشاقة"
  description="بطاريات بدء التشغيل للشاحنات والخدمة الشاقة من DINWEYS — JIS N150/N200 وDIN88/DIN100 وEFB/AGM، من إنتاج Chengguang Power Tech Co., Ltd. (2002). برامج تصنيع المعدات الأصلية والعلامات الخاصة."
  jsonLd={faqJsonLd}
>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>بطاريات بدء تشغيل الشاحنات،<br />صُمّمت للمسافات الطويلة.</h1>
          <p>
            تصنّع DINWEYS بطاريات بدء التشغيل للخدمة الشاقة للشاحنات والمركبات التجارية —
            JIS N150/N200 وDIN88/DIN100، وBCI مجموعة 31 عند الطلب. أمبير تدوير بارد بمستوى
            محركات الديزل، وأنظمة 12 فولت و24 فولت، وبرامج تصنيع المعدات الأصلية والعلامات
            الخاصة من مصنع تأسس عام 2002.
          </p>
          <div class="hero-actions">
            <a class="cta" href="/ar/selection-tool/">اعثر على بطاريتك</a>
            <a class="cta cta-outline" href="/ar/contact/">اطلب عرض سعر</a>
          </div>
        </div>
        <img
          class="hero-image"
          src="/images/factory/factory-01.jpg"
          alt="مصنع بطاريات DINWEYS من Chengguang Power Tech Co., Ltd. — خط إنتاج بطاريات الشاحنات والخدمة الشاقة"
          width="1200"
          height="655"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>النقاط الرئيسية</h2>
      <ol class="takeaways-list">
        <li><strong>بطاريات الشاحنات ليست مجرد بطاريات سيارات أكبر حجمًا</strong> — تتطلب محركات الديزل أمبير تدوير بارد أعلى بكثير، ومقاومة أكبر للاهتزاز، وتوصيلًا على التوالي بجهد 24 فولت؛ ويُعدّ الاختيار الخاطئ لحجم المجموعة، أو عدم كفاية CCA، أو سوء الصيانة، أو اختيار دورة التشغيل غير المناسبة من الأسباب الشائعة لمشكلات بطاريات بدء التشغيل في الأساطيل.</li>
        <li><strong>ثلاثة معايير، ثلاثة أسواق</strong> — JIS N150/N200 لآسيا والشرق الأوسط وأفريقيا، وDIN88/DIN100 لأوروبا (MAN وScania وVolvo وMercedes)، وBCI مجموعة 31/8D لأمريكا الشمالية.</li>
        <li><strong>مصنع بمساحة 200,000 م² و18 خط إنتاج آلي</strong> — من إنتاج Chengguang Power Tech Co., Ltd. (تأسست عام 2002)، وليست شركة تجارية.</li>
        <li><strong>نطاق كامل لتصنيع المعدات الأصلية والعلامات الخاصة</strong> — العلامة التجارية والتغليف والمواصفات ونوع الأقطاب، للموزعين والمستوردين والعلامات التجارية حول العالم.</li>
        <li><strong>IATF 16949 إلى جانب ISO 9001/14001/45001، والتصدير إلى أكثر من 70 دولة</strong> — اعتمادات جودة في سلسلة توريد السيارات، وليست ادعاءات تسويقية.</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>لماذا تحتاج الشاحنة إلى بطارية مختلفة</h2>
      <p class="lead">
        بطاريات بدء تشغيل الشاحنات ليست بطاريات سيارات أكبر حجمًا. تتطلب محركات الديزل أمبير
        تدوير بارد أعلى بكثير، ومقاومة للاهتزاز، وفي المركبات التجارية الثقيلة — تكوينات
        توصيل على التوالي بجهد 24 فولت. ويُعدّ اختيار حجم المجموعة أو تصنيف CCA الخاطئ سببًا
        شائعًا لأعطال الأساطيل.
      </p>
      <div class="grid grid-3">
        <div class="card">
          <h3>أمبير تدوير بارد بمستوى الديزل</h3>
          <p>أمبير تدوير بارد مرتفع لتدوير محركات الديزل الكبيرة في الطقس البارد.</p>
        </div>
        <div class="card">
          <h3>حجم المجموعة الصحيح</h3>
          <p>JIS N150/N200 أو DIN88/DIN100 — مطابقة لصينية بطارية مركبتك.</p>
        </div>
        <div class="card">
          <h3>أنظمة 12 فولت و24 فولت</h3>
          <p>تختلف الأنظمة الكهربائية بين الشاحنات الخفيفة والمركبات التجارية الثقيلة.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>نطاق منتجاتنا</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>JIS N150 / N200</h3>
          <p>بطاريات بألواح سميكة للخدمة الشاقة للشاحنات الكبيرة والحافلات والمولدات.</p>
          <a href="/ar/products/jis-heavy-duty/">عرض بطاريات JIS للخدمة الشاقة →</a>
        </div>
        <div class="card">
          <h3>DIN88 / DIN100</h3>
          <p>بطاريات بالمعيار الأوروبي لمركبات MAN وScania وVolvo وMercedes وغيرها.</p>
          <a href="/ar/products/din-heavy-duty/">عرض بطاريات DIN للخدمة الشاقة →</a>
        </div>
        <div class="card">
          <h3>BCI مجموعة 31 / 8D</h3>
          <p>أحجام المجموعات لأمريكا الشمالية، تُصنَّع حسب الطلب عبر خط إنتاج BCI لدينا.</p>
          <a href="/ar/products/bci-request/">BCI (عند الطلب) →</a>
        </div>
        <div class="card">
          <h3>أنظمة 24 فولت</h3>
          <p>أزواج بطاريات موصولة على التوالي للشاحنات الثقيلة والمقطورات النصفية والحافلات.</p>
          <a href="/ar/products/24v/">عرض أنظمة 24 فولت →</a>
        </div>
        <div class="card">
          <h3>EFB وAGM</h3>
          <p>بطاريات مغمورة محسّنة وحصيرة زجاجية ماصة لدورات التشغيل التجارية الشاقة.</p>
          <a href="/ar/products/fleet/">عرض EFB/AGM →</a>
        </div>
        <div class="card">
          <h3>الأساطيل وتصنيع المعدات الأصلية</h3>
          <p>توريد بالجملة، واتساق بين الدفعات، ووثائق لمشغلي الأساطيل.</p>
          <a href="/ar/products/fleet/">برامج الأساطيل →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>التطبيقات التي نخدمها</h2>
      <p class="lead" style="margin-bottom:24px;">
        تتطلب دورات التشغيل التجارية المختلفة بطاريات مختلفة — وعادات صيانة مختلفة. تعرّف على
        كيفية تلبية تشكيلتنا للخدمة الشاقة لكل بيئة.
      </p>
      <div class="grid grid-2">
        <div class="card">
          <h3>التعدين والطرق الوعرة</h3>
          <p>تصميم مقاوم للاهتزاز ومحكم ضد الغبار لشاحنات النقل والحفارات ومنصات الحفر.</p>
          <a href="/ar/applications/mining-off-highway/">عرض بطاريات التعدين →</a>
        </div>
        <div class="card">
          <h3>سلسلة التبريد والمبرّدات</h3>
          <p>بدء تشغيل بأمبير تدوير بارد عالٍ مع بنك منفصل للتفريغ العميق لوحدة التبريد.</p>
          <a href="/ar/applications/cold-chain-refrigerated/">عرض بطاريات سلسلة التبريد →</a>
        </div>
        <div class="card">
          <h3>الحافلات</h3>
          <p>ألواح سميكة تتحمل التفريغ العميق وسعة احتياطية كبيرة للتوقفات المتكررة.</p>
          <a href="/ar/applications/bus-coach/">عرض بطاريات الحافلات →</a>
        </div>
        <div class="card">
          <h3>مولدات الديزل</h3>
          <p>بطاريات احتياطية تحتفظ بشحنها خلال أشهر التوقف وتدور عند الطلب.</p>
          <a href="/ar/applications/diesel-generator/">عرض بطاريات المولدات →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>الأسواق التي نزوّدها</h2>
      <p class="lead" style="margin-bottom:24px;">
        لكل منطقة معيار البطاريات الخاص بها. نوفر ونصنّع وفق المعيار المناسب لسوقك — من JIS
        في آسيا وأفريقيا إلى BCI في الأمريكتين.
      </p>
      <div class="grid grid-2">
        <div class="card">
          <h3>الشرق الأوسط</h3>
          <p>JIS N150/N200 وDIN لأسطول مختلط من المركبات اليابانية والأوروبية.</p>
          <a href="/ar/markets/middle-east/">سوق الشرق الأوسط →</a>
        </div>
        <div class="card">
          <h3>أفريقيا</h3>
          <p>سلسلة JIS N للحرارة والغبار والطرق الوعرة لأساطيل أفريقيا جنوب الصحراء.</p>
          <a href="/ar/markets/africa/">سوق أفريقيا →</a>
        </div>
        <div class="card">
          <h3>أمريكا اللاتينية</h3>
          <p>BCI مجموعة 31/8D لتلائم الشاحنات الثقيلة في أمريكا الشمالية.</p>
          <a href="/ar/markets/latin-america/">سوق أمريكا اللاتينية →</a>
        </div>
        <div class="card">
          <h3>جنوب شرق آسيا</h3>
          <p>JIS N150/N200 للأساطيل اليابانية والكورية المهيمنة في المنطقة.</p>
          <a href="/ar/markets/southeast-asia/">سوق جنوب شرق آسيا →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>تصنيع المعدات الأصلية والعلامات الخاصة</h2>
      <p class="lead">
        DINWEYS هي العلامة التجارية لبطاريات الشاحنات التابعة لشركة Chengguang Power Tech Co., Ltd.، وهي شركة
        مصنّعة تأسست عام 2002. ومن منشأة بمساحة 200,000 م² تضم 18 خط إنتاج آلي، ندعم برامج
        تصنيع المعدات الأصلية والعلامات الخاصة للموزعين والمستوردين والعلامات التجارية حول العالم.
      </p>
      <p class="data-note" style="max-width:780px;">
        معتمدون وفق IATF 16949 · ISO 9001:2015 · ISO 14001:2015 · ISO 45001:2018 · مطابقة CE.
        التصدير إلى أكثر من 70 دولة.
      </p>
      <a class="cta" href="/ar/contact/" style="display:inline-block;margin-top:8px;">ناقش برامج OEM / العلامة الخاصة</a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>ما يقدّره شركاؤنا</h2>
      <p class="lead" style="margin-bottom:24px;">
        موضوعات متكررة لدى الموزعين والمستوردين ومشغلي الأساطيل الذين نزوّدهم في أكثر من
        70 دولة.
      </p>
      <div class="testimonial">
        <blockquote>
          "يبرز موزعو الشرق الأوسط باستمرار الاتساق من دفعة إلى أخرى — فكل شحنة تُرسل
          مع بيانات اختبار CCA ووثائق كاملة."
        </blockquote>
        <p class="attribution">— شركاء التوزيع، الشرق الأوسط</p>
      </div>
      <div class="testimonial">
        <blockquote>
          "يقدّر مستوردو أمريكا الجنوبية سرعة التخصيص بتصنيع المعدات الأصلية — من الرسم
          الهندسي إلى العينة المعتمدة، مع علامة تجارية وتغليف وفق المواصفات."
        </blockquote>
        <p class="attribution">— شركاء الاستيراد، أمريكا الجنوبية</p>
      </div>
      <div class="testimonial">
        <blockquote>
          "أهم ما يهم مشغلي الأساطيل هو التسليم في الموعد ووثائق الشحن الكاملة."
        </blockquote>
        <p class="attribution">— مشغلو الأساطيل</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>الأسئلة الشائعة</h2>
      <div class="faq-item">
        <h3>ما حجم مجموعة البطارية الذي تحتاجه شاحنتي؟</h3>
        <p>تستخدم شاحنات الخدمة الشاقة في الغالب بطاريات JIS N150/N200 (الطرازان 145G51/190H52) أو DIN88/DIN100 حسب السوق. أما مركبات أمريكا الشمالية فتستخدم BCI مجموعة 31 (متاحة عند الطلب). تأكد من حجم المجموعة على بطاريتك الحالية أو في دليل المركبة.</p>
      </div>
      <div class="faq-item">
        <h3>هل تستخدم شاحنات الخدمة الشاقة أنظمة 12 فولت أم 24 فولت؟</h3>
        <p>تستخدم معظم الشاحنات النصفية والمركبات التجارية الثقيلة أنظمة 24 فولت (بطاريتان 12 فولت على التوالي)؛ بينما تستخدم الشاحنات الخفيفة والبيك أب أنظمة 12 فولت. تحقق من مواصفات مركبتك قبل الطلب.</p>
      </div>
      <div class="faq-item">
        <h3>ما مقدار CCA الذي تحتاجه بطارية شاحنة الديزل؟</h3>
        <p>تحتاج محركات الديزل إلى CCA عالٍ. وتتطلب شاحنات الخدمة الشاقة عادةً 800–1100+ CCA حسب حجم المحرك والمناخ — فكلما كان المناخ أبرد زادت الحاجة. أكد الرقم الدقيق في دليل مركبتك.</p>
      </div>
      <div class="faq-item">
        <h3>هل تقدّمون بطاريات شاحنات بتصنيع OEM وعلامة خاصة؟</h3>
        <p>نعم. DINWEYS هي العلامة التجارية لبطاريات الشاحنات التابعة لشركة Chengguang Power Tech Co., Ltd. (تأسست عام 2002)، وتقدّم برامج تصنيع المعدات الأصلية والعلامات الخاصة مع علامة تجارية وتغليف ومواصفات مخصصة.</p>
      </div>
      <p style="margin-top:24px;">
        📚 هل تبحث عن إرشادات فنية؟ زر
        <a href="https://docs.dinweysbattery.com/">مركز DINWEYS للمعرفة</a> للاطلاع على أدلة
        الاختيار، ومعايير JIS مقابل DIN مقابل BCI، ووثائق CCA و12 فولت مقابل 24 فولت.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>الأدلة الفنية</h2>
      <p class="lead" style="margin-bottom:24px;">
        أدلة متعمقة من مركز DINWEYS للمعرفة — يكتبها ويراجعها فريقنا الفني، استنادًا إلى
        وثائق الشركة المصنعة ضمن نظام جودة IATF 16949.
      </p>
      <div class="grid grid-3">
        <div class="card">
          <h3>الدليل الشامل لبطارية الشاحنة</h3>
          <p>CCA والسعة الاحتياطية وAh وEFB وAGM وكيمياء الألواح — الأساسيات في مكان واحد.</p>
          <a href="https://docs.dinweysbattery.com/complete-guide/">اقرأ الدليل →</a>
        </div>
        <div class="card">
          <h3>ما هو CCA؟</h3>
          <p>شرح أمبير التدوير البارد، مع جدول متطلبات فئة الشاحنات وإرشادات المناخ.</p>
          <a href="https://docs.dinweysbattery.com/what-is-cca/">اقرأ الدليل →</a>
        </div>
        <div class="card">
          <h3>JIS مقابل DIN مقابل BCI</h3>
          <p>المعايير الإقليمية الثلاثة للبطاريات، وأرقام الموديلات، والمرجعية المتقاطعة — مشروحة.</p>
          <a href="https://docs.dinweysbattery.com/jis-vs-din-vs-bci/">اقرأ الدليل →</a>
        </div>
        <div class="card">
          <h3>أنظمة 12 فولت مقابل 24 فولت</h3>
          <p>لماذا تستخدم الشاحنات الثقيلة 24 فولت، وكيف يبني التوصيل على التوالي نظام 24 فولت من بطاريتين 12 فولت.</p>
          <a href="https://docs.dinweysbattery.com/12v-vs-24v/">اقرأ الدليل →</a>
        </div>
        <div class="card">
          <h3>AGM مقابل المغمورة</h3>
          <p>مقارنة بين الحصيرة الزجاجية الماصة وبطاريات الرصاص الحمضية المغمورة من حيث الاهتزاز والبدء البارد والتكلفة.</p>
          <a href="https://docs.dinweysbattery.com/agm-vs-flooded/">اقرأ الدليل →</a>
