---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما البطارية التي تستخدمها الحافلات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تستخدم الحافلات بطاريات تشغيل للخدمة الشاقة مطابقة للمحرك — عادةً 24V للحافلات الكبيرة بين المدن (بطاريتان 12V على التوالي) و12V لحافلات المدن الأصغر. وتتبع مقاسات المجموعات السوق: JIS N150/N200 أو DIN88/DIN100."
      }
    },
    {
      "@type": "Question",
      "name": "لماذا تتآكل بطاريات الحافلات أسرع من بطاريات الشاحنات؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تُدير الحافلات بطارياتها بدورات أقسى من شاحنات النقل لمسافات طويلة — فبدء التشغيل المتكرر وفترات الخمول الطويلة وحمل الأجهزة الملحقة المستمر (الإضاءة والأبواب والتدفئة والتهوية والتكييف ومعلومات الركاب) يستنزف البطارية طوال يوم العمل. لذا لا غنى عن ألواح سميكة تتحمل الدورات العميقة وسعة احتياطية وافرة."
      }
    },
    {
      "@type": "Question",
      "name": "هل تستخدم الحافلات أنظمة 12V أم 24V؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تستخدم الحافلات الكبيرة بين المدن عادةً 24V (بطاريتان 12V على التوالي)؛ بينما تستخدم حافلات المدن الأصغر وحافلات النقل الصغيرة غالبًا 12V. طابِق دائمًا مواصفات المركبة."
      }
    },
    {
      "@type": "Question",
      "name": "ما السعة الاحتياطية التي تحتاجها الحافلة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تستفيد الحافلة من سعة احتياطية وافرة بسبب حمل الأجهزة الملحقة المستمر. يوفّر JIS N150 سعة 220 دقيقة ويوفّر N200 سعة 320 دقيقة (SAE J537) — احتياطيًا للإضاءة والأبواب والتليماتية عند إيقاف المحرك أو خموله."
      }
    }
  ]
};
---

<BaseLayout
  title="بطاريات تشغيل الحافلات — تصنيع OEM من DINWEYS"
  description="بطاريات تشغيل للخدمة الشاقة للحافلات — ألواح سميكة تتحمل الدورات العميقة وسعة احتياطية عالية وخيارات 12V/24V. توريد OEM من DINWEYS."
  jsonLd={faqJsonLd}
>
  <div class="container section">
    <nav aria-label="مسار التنقل" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/ar/" style="color:#1e5aa8;">الرئيسية</a> &rsaquo; التطبيقات &rsaquo; الحافلات
    </nav>
    <h1 style="color:#0f1f3d;">بطاريات تشغيل الحافلات</h1>
    <p class="lead">
      تُدير حافلات المدن والحافلات بين المدن بطارياتها بدورات أقسى من شاحنات النقل لمسافات
      طويلة — فبدء التشغيل المتكرر وفترات الخمول الطويلة وحمل الأجهزة الملحقة المستمر يتطلب
      ألواحًا سميكة تتحمل الدورات العميقة وسعة احتياطية وافرة.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">النقاط الرئيسية</h2>
    <ol class="takeaways-list">
      <li><strong>دورات الحافلات أقسى من الشاحنات</strong> — التوقف المتكرر والخمول الطويل وحمل الأجهزة الملحقة المستمر (الإضاءة والأبواب والتدفئة والتهوية والتكييف ومعلومات الركاب) يستنزف البطارية طوال يوم العمل.</li>
      <li><strong>ألواح Pb-Sb السميكة تتحمل الدورات العميقة</strong> — البنية نفسها المتحملة للدورات العميقة المستخدمة في بطاريات الشاحنات الثقيلة تُبقي الحافلة قادرة على التشغيل بموثوقية طوال الوردية.</li>
      <li><strong>السعة الاحتياطية هي الاحتياطي عند إيقاف المحرك</strong> — يوفّر N150 سعة 220 دقيقة، ويوفّر N200 سعة 320 دقيقة (SAE J537) للإضاءة والتليماتية وحالة تعطل الدينامو.</li>
      <li><strong>الحافلات الكبيرة تعمل بـ 24V</strong> — بطاريتان 12V على التوالي؛ وحافلات المدن والنقل الأصغر غالبًا 12V — طابِق المركبة دائمًا.</li>
    </ol>

    <h2 style="color:#0f1f3d;margin-top:32px;">لماذا تحتاج الحافلات بنية للخدمة الشاقة</h2>
    <p>
      الفرق بين الحافلة والشاحنة طويلة المسافات هو دورة التشغيل. فالشاحنة تعمل ساعات بينما
      يبقي الدينامو البطارية مشحونة. أما حافلة المدينة فتبدأ وتتوقف عشرات المرات يوميًا، وتخمل في
      الازدحام وأثناء صعود الركاب، وتشغّل باستمرار الأبواب والإضاءة الداخلية والتدفئة والتهوية
      والتكييف وأنظمة معلومات الركاب — حتى عند إيقاف المحرك.
    </p>
    <p>
      كل حمل ملحق يدفع البطارية تدريجيًا نحو التفريغ، وكل إعادة تشغيل تطلب دفعة تدوير بارد
      جديدة. ولوح سيارة خفيف سيتعطل مبكرًا تحت هذا التدوير المتكرر. وقد صُمم تصميم DINWEYS للخدمة
      الشاقة بألواح سميكة (Pb-Sb) لهذه الظروف تحديدًا — ليتحمل التفريغ الجزئي وإعادة الشحن
      المتكررين مع توفير CCA العالي الذي يحتاجه محرك ديزل كبير في كل تشغيل.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">المواصفات الموصى بها</h2>
    <table>
      <thead>
        <tr><th>المتطلب</th><th>المواصفة</th></tr>
      </thead>
      <tbody>
        <tr><td>جهد النظام</td><td>24V للحافلات الكبيرة (بطاريتان 12V على التوالي)؛ 12V للحافلات الصغيرة</td></tr>
        <tr><td>أمبير التدوير البارد (CCA)</td><td>850–1100+ CCA لمحركات الديزل الكبيرة</td></tr>
        <tr><td>مقاس المجموعة</td><td>JIS N150 (145G51) / N200 (190H52) أو DIN88/DIN100</td></tr>
        <tr><td>السعة الاحتياطية</td><td>N150 220 دقيقة · N200 320 دقيقة (SAE J537)</td></tr>
        <tr><td>البنية</td><td>مغمورة بألواح سميكة (Pb-Sb)؛ AGM للأساطيل الخالية من الصيانة</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      المواصفات نطاقات تمثيلية. تأكد من مقاس المجموعة وCCA والجهد الدقيقين وفق دليل المركبة —
      تواصل معنا للحصول على ورقة بيانات.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">خطوط المنتجات لأساطيل الحافلات</h2>
    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h3>JIS للخدمة الشاقة (N150/N200)</h3>
        <p>145G51 (N150) 900A CCA / 220 دقيقة RC و190H52 (N200) 1100A CCA / 320 دقيقة RC.</p>
        <a href="/ar/products/jis-heavy-duty/">اعرض JIS للخدمة الشاقة ←</a>
      </div>
      <div class="card">
        <h3>DIN للخدمة الشاقة (DIN88/DIN100)</h3>
        <p>بطاريات بالمعيار الأوروبي لحافلات MAN وMercedes وScania وVolvo.</p>
        <a href="/ar/products/din-heavy-duty/">اعرض DIN للخدمة الشاقة ←</a>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما البطارية التي تستخدمها الحافلات؟</h3>
      <p>تستخدم الحافلات بطاريات تشغيل للخدمة الشاقة مطابقة للمحرك — عادةً 24V للحافلات الكبيرة بين المدن (بطاريتان 12V على التوالي) و12V لحافلات المدن الأصغر. وتتبع مقاسات المجموعات السوق: JIS N150/N200 أو DIN88/DIN100.</p>
    </div>
    <div class="faq-item">
      <h3>لماذا تتآكل بطاريات الحافلات أسرع من بطاريات الشاحنات؟</h3>
      <p>تُدير الحافلات بطارياتها بدورات أقسى من شاحنات النقل لمسافات طويلة — فبدء التشغيل المتكرر وفترات الخمول الطويلة وحمل الأجهزة الملحقة المستمر (الإضاءة والأبواب والتدفئة والتهوية والتكييف ومعلومات الركاب) يستنزف البطارية طوال يوم العمل. لذا لا غنى عن ألواح سميكة تتحمل الدورات العميقة وسعة احتياطية وافرة.</p>
    </div>
    <div class="faq-item">
      <h3>هل تستخدم الحافلات أنظمة 12V أم 24V؟</h3>
      <p>تستخدم الحافلات الكبيرة بين المدن عادةً 24V (بطاريتان 12V على التوالي)؛ بينما تستخدم حافلات المدن الأصغر وحافلات النقل الصغيرة غالبًا 12V. طابِق دائمًا مواصفات المركبة.</p>
    </div>
    <div class="faq-item">
      <h3>ما السعة الاحتياطية التي تحتاجها الحافلة؟</h3>
      <p>تستفيد الحافلة من سعة احتياطية وافرة بسبب حمل الأجهزة الملحقة المستمر. يوفّر JIS N150 سعة 220 دقيقة ويوفّر N200 سعة 320 دقيقة (SAE J537) — احتياطيًا للإضاءة والأبواب والتليماتية عند إيقاف المحرك أو خموله.</p>
    </div>

    <p style="margin-top:24px;">
      📚 اقرأ الدليل الكامل: <a href="https://docs.dinweysbattery.com/fleet-battery-management/" target="_blank" rel="noopener">إدارة بطاريات الأساطيل</a>
    </p>
  </div>
</BaseLayout>
