---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما البطارية التي تحتاجها الشاحنة المبرّدة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تحتاج الشاحنة المبرّدة نظامين منفصلين: بطارية تشغيل بقدرة 850–1100+ CCA للمحرك، وبنك بطاريات مساعد بدورة عميقة أو AGM لوحدة التبريد. ولا يمكن لبطارية واحدة أداء المهمتين."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكنني تشغيل وحدة التبريد من بطارية التشغيل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "لا. تسحب وحدة تبريد بقدرة 25 A نحو 200 Ah خلال 8 ساعات، وستُفرّغ بطارية التشغيل تفريغًا عميقًا فتُتلفها وتُخاطر بعدم التشغيل في منتصف الطريق. استخدم بنك بطاريات مساعدًا منفصلًا."
      }
    },
    {
      "@type": "Question",
      "name": "ما نوع البطارية الأفضل لوحدة التبريد؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "بطاريات الدورة العميقة أو AGM هي الأفضل للسحب المستمر لوحدة التبريد — فهي تتحمل التفريغ المتكرر إلى نحو 50% دون تلف الألواح الذي تتعرض له بطارية التشغيل."
      }
    },
    {
      "@type": "Question",
      "name": "كيف أحدد حجم البنك المساعد لوحدة التبريد؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "حدّده وفق تيار السحب المستمر لوحدة التبريد ومدة التشغيل المطلوبة. تحتاج وحدة بقدرة 25 A تعمل 8 ساعات إلى نحو 200 Ah قابلة للاستخدام — أي بنك بنحو 400 Ah عند حد عمق التفريغ 50%. وتأكد من سحب الوحدة وفق مواصفاتها."
      }
    }
  ]
};
---

<BaseLayout
  title="بطاريات سلسلة التبريد والمبرّدات — تصنيع OEM من DINWEY"
  description="بطاريات تشغيل ومساعدة للشاحنات المبرّدة — CCA عالٍ للمحرك مع بنك بدورة عميقة لوحدة التبريد. توريد OEM من DINWEY."
  jsonLd={faqJsonLd}
>
  <div class="container section">
    <nav aria-label="مسار التنقل" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/ar/" style="color:#1e5aa8;">الرئيسية</a> &rsaquo; التطبيقات &rsaquo; سلسلة التبريد والمبرّدات
    </nav>
    <h1 style="color:#0f1f3d;">بطاريات شاحنات سلسلة التبريد والمبرّدات</h1>
    <p class="lead">
      تحمل الشاحنة المبرّدة حِملين كهربائيين يحتاجان بطاريتين مختلفتين: دفعة التشغيل البارد
      للمحرك، والسحب المستمر لساعات لوحدة التبريد. والخلط بينهما يُعطّل السائق في منتصف الطريق.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">النقاط الرئيسية</h2>
    <ol class="takeaways-list">
      <li><strong>حِملان يستلزمان نوعين من البطاريات</strong> — بطارية تشغيل (SLI) لدفعة التدوير البارد 850–1100+ CCA، وبنك منفصل بدورة عميقة للسحب المستمر لوحدة التبريد.</li>
      <li><strong>لا تشغّل وحدة التبريد أبدًا من بطارية التشغيل</strong> — تسحب وحدة بقدرة 25 A نحو 200 Ah خلال 8 ساعات وتُفرّغ الألواح تفريغًا عميقًا؛ فتعمل الشاحنة جيدًا في الساحة ثم تترك السائق متعطلًا بعد توقف ليلي.</li>
      <li><strong>الفصل وحده لا يكفي</strong> — العازل البسيط لا يحجب إلا التيار العكسي ويهبط بنحو 0.3–0.7 V؛ بينما يوفّر شاحن DC-DC أيضًا شحنًا متعدد المراحل مناسبًا يحتاجه البنك المساعد المتعرّض للتدوير المتكرر.</li>
      <li><strong>حدّد حجم البنك وفق السحب</strong> — تستهلك مهمة 25 A لمدة 8 ساعات نحو 200 Ah قابلة للاستخدام، أي بنك بنحو 400 Ah عند حد عمق التفريغ 50%.</li>
    </ol>

    <h2 style="color:#0f1f3d;margin-top:32px;">لماذا تحتاج وحدة التبريد نظامين</h2>
    <p>
      الحِملان مختلفان جوهريًا. المحرك يحتاج دفعة قصيرة عالية التيار — 850–1100+ CCA لمحرك
      ديزل كبير — تُسلَّم في ثوانٍ. أما وحدة التبريد فتحتاج تيارًا متوسطًا لكن مستمرًا لساعات
      بينما تكون الشاحنة متوقفة ليلًا أو أثناء التحميل.
    </p>
    <p>
      صُنعت بطارية التشغيل للمهمة الأولى: ألواح رقيقة تسلّم تيارًا عاليًا لفترة قصيرة. وسحب هذه
      البطارية على نحو مستمر لساعات — كما تفعل وحدة التبريد — يُفرّغها تفريغًا عميقًا ويُتلف
      ألواحها إتلافًا دائمًا. والنتيجة مركبة تعمل جيدًا عند الانطلاق من المستودع لكنها ترفض
      الدوران في الصباح التالي. والحل بنك منفصل بدورة عميقة أو AGM مخصص لوحدة التبريد، مع فصل
      البنكين كي لا يستنزف أحدهما الآخر.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">المواصفات الموصى بها</h2>
    <table>
      <thead>
        <tr><th>الحِمل</th><th>نوع البطارية</th><th>الرقم الرئيسي</th></tr>
      </thead>
      <tbody>
        <tr><td>تشغيل المحرك</td><td>بطارية تشغيل (SLI)</td><td>850–1100+ CCA</td></tr>
        <tr><td>وحدة التبريد</td><td>بنك مساعد بدورة عميقة أو AGM</td><td>نحو 200 Ah قابلة للاستخدام لكل 25 A / 8 ساعات</td></tr>
        <tr><td>جهد النظام</td><td>12V أو 24V حسب المركبة</td><td>تُطبَّق قاعدة الزوج المتطابق</td></tr>
        <tr><td>عمق تفريغ البنك المساعد</td><td>حد نحو 50%</td><td>بنك بنحو 400 Ah مقابل 200 Ah قابلة للاستخدام</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      الأرقام تمثيلية. تعتمد قيم CCA الدقيقة وسعة البنك ومدة التشغيل على السحب المحدد لوحدة
      التبريد — تواصل معنا للحصول على ورقة بيانات مطابقة لأسطولك.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">خطوط المنتجات لأساطيل سلسلة التبريد</h2>
    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h3>بطاريات التشغيل (N150/N200 / DIN)</h3>
        <p>بطاريات تشغيل بـ CCA عالٍ للقاطرة — JIS 145G51/190H52 أو DIN 58827/60038.</p>
        <a href="/ar/products/jis-heavy-duty/">اعرض JIS للخدمة الشاقة ←</a>
      </div>
      <div class="card">
        <h3>البنوك المساعدة وAGM</h3>
        <p>دورة عميقة وAGM للسحب المستمر لوحدة التبريد — محكمة الإغلاق وخالية من الصيانة.</p>
        <a href="/ar/products/fleet/">اعرض الأساطيل وAGM ←</a>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما البطارية التي تحتاجها الشاحنة المبرّدة؟</h3>
      <p>تحتاج الشاحنة المبرّدة نظامين منفصلين: بطارية تشغيل بقدرة 850–1100+ CCA للمحرك، وبنك بطاريات مساعد بدورة عميقة أو AGM لوحدة التبريد. ولا يمكن لبطارية واحدة أداء المهمتين.</p>
    </div>
    <div class="faq-item">
      <h3>هل يمكنني تشغيل وحدة التبريد من بطارية التشغيل؟</h3>
      <p>لا. تسحب وحدة تبريد بقدرة 25 A نحو 200 Ah خلال 8 ساعات، وستُفرّغ بطارية التشغيل تفريغًا عميقًا فتُتلفها وتُخاطر بعدم التشغيل في منتصف الطريق. استخدم بنك بطاريات مساعدًا منفصلًا.</p>
    </div>
    <div class="faq-item">
      <h3>ما نوع البطارية الأفضل لوحدة التبريد؟</h3>
      <p>بطاريات الدورة العميقة أو AGM هي الأفضل للسحب المستمر لوحدة التبريد — فهي تتحمل التفريغ المتكرر إلى نحو 50% دون تلف الألواح الذي تتعرض له بطارية التشغيل.</p>
    </div>
    <div class="faq-item">
      <h3>كيف أحدد حجم البنك المساعد لوحدة التبريد؟</h3>
      <p>حدّده وفق تيار السحب المستمر لوحدة التبريد ومدة التشغيل المطلوبة. تحتاج وحدة بقدرة 25 A تعمل 8 ساعات إلى نحو 200 Ah قابلة للاستخدام — أي بنك بنحو 400 Ah عند حد عمق التفريغ 50%. وتأكد من سحب الوحدة وفق مواصفاتها.</p>
    </div>

    <p style="margin-top:24px;">
      📚 اقرأ الدليل الكامل: <a href="https://docs.dinweysbattery.com/cold-chain-refrigerated/" target="_blank" rel="noopener">اختيار بطاريات سلسلة التبريد والمبرّدات</a>
    </p>
  </div>
</BaseLayout>
