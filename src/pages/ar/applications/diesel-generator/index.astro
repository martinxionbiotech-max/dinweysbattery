---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما البطارية التي يستخدمها مولد الديزل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تستخدم مولدات الديزل بطارية تشغيل مطابقة لمتطلبات تدوير المحرك — غالبًا بطارية مغمورة أو AGM للخدمة الشاقة بقدرة 850–1100+ CCA. وقد تستخدم المولدات الأكبر أنظمة تشغيل 24V."
      }
    },
    {
      "@type": "Question",
      "name": "كيف تختلف بطارية المولد عن بطارية المركبة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الكيمياء واحدة؛ أما المهمة فليست كذلك. فبطارية المركبة يعيد الدينامو شحنها يوميًا، بينما تبقى بطارية المولد خامدة وتُفرّغ نفسها ذاتيًا بنسبة 3–5% شهريًا — أي 9–15% من بطارية 135 Ah خلال ثلاثة أشهر من الخمول — ومع ذلك يجب أن توفّر CCA عاليًا عند الطلب. وشاحن التعويم، لا الدينامو، هو ما يبقيها حيّة."
      }
    },
    {
      "@type": "Question",
      "name": "لماذا تتعطل بطاريات المولدات الاحتياطية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "بسبب الكبرتة لا الاستخدام. فالبطارية التي تبقى في حالة شحن منخفضة لأشهر تُفرّغ نفسها ذاتيًا وتكبرت تدريجيًا، فتفقد السعة بشكل غير مرئي حتى تلك الليلة الباردة التي يجب فيها تشغيل المولد. ويمنع ذلك شاحن تعويم أو جهاز حفظ الشحن."
      }
    },
    {
      "@type": "Question",
      "name": "كم مرة ينبغي استبدال بطارية المولد؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تعيش بطاريات المولدات عادةً 3–5 سنوات، لكن الوحدات الاحتياطية الخامدة تحتاج شحنًا منتظمًا لتفادي الكبرتة. اختبرها سنويًا واستبدلها استباقيًا قبل أي تشغيل حرج."
      }
    }
  ]
};
---

<BaseLayout
  title="بطاريات تشغيل مولدات الديزل — تصنيع OEM من DINWEY"
  description="بطاريات تشغيل للمولدات الاحتياطية والرئيسية العاملة بالديزل — CCA عالٍ عند الطلب مع انضباط الشحن العائم الذي تتطلبه مهمة الاحتياط. توريد OEM من DINWEY."
  jsonLd={faqJsonLd}
>
  <div class="container section">
    <nav aria-label="مسار التنقل" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/ar/" style="color:#1e5aa8;">الرئيسية</a> &rsaquo; التطبيقات &rsaquo; مولدات الديزل
    </nav>
    <h1 style="color:#0f1f3d;">بطاريات تشغيل مولدات الديزل</h1>
    <p class="lead">
      بطارية المولد الاحتياطي هي المكوّن الأكثر عرضة للتعطل — لا لأنها تعمل بجهد، بل لأنها تبقى
      خامدة لأشهر ويُتوقع منها أن تدور عند الطلب. الكيمياء هي نفسها كيميائية بطارية الشاحنة؛ أما
      المهمة فليست كذلك.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">النقاط الرئيسية</h2>
    <ol class="takeaways-list">
      <li><strong>الخمول هو العدو لا الاستخدام</strong> — البطارية بلا حِمل تظل تُفرّغ نفسها ذاتيًا بنحو 3–5% شهريًا؛ وبطارية N150 بسعة 135 Ah تفقد 9–15% من سعتها خلال ثلاثة أشهر خمول.</li>
      <li><strong>شاحن التعويم يبقيها حيّة، لا تصنيف CCA</strong> — يعيد الدينامو شحن بطارية المركبة يوميًا؛ أما المولد الاحتياطي فلا يملك دورة تشغيل مماثلة، لذا يحافظ الشاحن أو جهاز حفظ الشحن على الشحنة.</li>
      <li><strong>الكبرتة هي القاتل الصامت</strong> — البطارية المتروكة دون شحن كامل تكبرت تدريجيًا، فتفقد السعة بشكل غير مرئي حتى الليلة الباردة التي يجب فيها تشغيل المولد.</li>
      <li><strong>اختبر سنويًا واستبدل استباقيًا</strong> — عمر الخدمة النموذجي 3–5 سنوات، لكن المواقع الحيوية تستدعي اختبار حمل سنويًا واستبدالًا مخططًا.</li>
    </ol>

    <h2 style="color:#0f1f3d;margin-top:32px;">لماذا تختلف مهمة المولد</h2>
    <p>
      بطارية الشاحنة تكسب قيمتها يوميًا: يُشغَّل المحرك، ويعيد الدينامو شحنها، وتتكرر الدورة.
      أما المولد الاحتياطي فيبقى في موضعه أسابيع أو أشهرًا، يُفرّغ نفسه ذاتيًا ببطء بمعدل
      3–5% شهريًا، ثم — لحظة انقطاع الشبكة أو طلب نظام التحكم بدء التشغيل — يجب أن يسلّم دفعة
      التدوير البارد الكاملة فورًا.
    </p>
    <p>
      ونمط العطل غير مرئي. فبينما تبقى البطارية دون شحن كامل، تتكوّن بلورات كبريتات الرصاص على
      الألواح وتتصلب، مما يقلل السعة بشكل دائم. ولا يرى المشغل أي إنذار حتى الصباح الحاسم الذي
      يرفض فيه المولد الدوران. والعلاج منهجي: شاحن تعويم أو جهاز حفظ شحن يبقي البطارية عند شحن
      كامل، مع اختبار حمل سنوي يرصد البطارية المتراجعة قبل أن تصبح المشكلة حرجة.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">المواصفات الموصى بها</h2>
    <table>
      <thead>
        <tr><th>المتطلب</th><th>المواصفة</th></tr>
      </thead>
      <tbody>
        <tr><td>أمبير التدوير البارد (CCA)</td><td>850–1100+ CCA مطابقة للمحرك</td></tr>
        <tr><td>جهد النظام</td><td>12V أو 24V حسب نظام تشغيل المولد</td></tr>
        <tr><td>البنية</td><td>مغمورة للخدمة الشاقة أو AGM</td></tr>
        <tr><td>التفريغ الذاتي (خمول)</td><td>3–5% شهريًا</td></tr>
        <tr><td>عمر الخدمة</td><td>3–5 سنوات مع انضباط الشحن العائم</td></tr>
        <tr><td>الصيانة</td><td>شاحن تعويم + اختبار حمل سنوي</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      المواصفات نطاقات تمثيلية. تواصل معنا للحصول على ورقة بيانات مطابقة لمحرك مولدك وجهد نظام
      تشغيله.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">خطوط المنتجات لتشغيل المولدات</h2>
    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h3>JIS للخدمة الشاقة (N150/N200)</h3>
        <p>بطاريات مغمورة بألواح سميكة تتحمل حياة الشحن العائم — 145G51 و190H52.</p>
        <a href="/ar/products/jis-heavy-duty/">اعرض JIS للخدمة الشاقة ←</a>
      </div>
      <div class="card">
        <h3>AGM (خالية من الصيانة)</h3>
        <p>AGM محكمة الإغلاق لبيئات المولدات الاحتياطية منخفضة الصيانة والمواقع الحيوية.</p>
        <a href="/ar/products/fleet/">اعرض الأساطيل وAGM ←</a>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما البطارية التي يستخدمها مولد الديزل؟</h3>
      <p>تستخدم مولدات الديزل بطارية تشغيل مطابقة لمتطلبات تدوير المحرك — غالبًا بطارية مغمورة أو AGM للخدمة الشاقة بقدرة 850–1100+ CCA. وقد تستخدم المولدات الأكبر أنظمة تشغيل 24V.</p>
    </div>
    <div class="faq-item">
      <h3>كيف تختلف بطارية المولد عن بطارية المركبة؟</h3>
      <p>الكيمياء واحدة؛ أما المهمة فليست كذلك. فبطارية المركبة يعيد الدينامو شحنها يوميًا، بينما تبقى بطارية المولد خامدة وتُفرّغ نفسها ذاتيًا بنسبة 3–5% شهريًا — أي 9–15% من بطارية 135 Ah خلال ثلاثة أشهر من الخمول — ومع ذلك يجب أن توفّر CCA عاليًا عند الطلب. وشاحن التعويم، لا الدينامو، هو ما يبقيها حيّة.</p>
    </div>
    <div class="faq-item">
      <h3>لماذا تتعطل بطاريات المولدات الاحتياطية؟</h3>
      <p>بسبب الكبرتة لا الاستخدام. فالبطارية التي تبقى في حالة شحن منخفضة لأشهر تُفرّغ نفسها ذاتيًا وتكبرت تدريجيًا، فتفقد السعة بشكل غير مرئي حتى تلك الليلة الباردة التي يجب فيها تشغيل المولد. ويمنع ذلك شاحن تعويم أو جهاز حفظ الشحن.</p>
    </div>
    <div class="faq-item">
      <h3>كم مرة ينبغي استبدال بطارية المولد؟</h3>
      <p>تعيش بطاريات المولدات عادةً 3–5 سنوات، لكن الوحدات الاحتياطية الخامدة تحتاج شحنًا منتظمًا لتفادي الكبرتة. اختبرها سنويًا واستبدلها استباقيًا قبل أي تشغيل حرج.</p>
    </div>

    <p style="margin-top:24px;">
      📚 اقرأ الدليل الكامل: <a href="https://docs.dinweysbattery.com/diesel-generator/" target="_blank" rel="noopener">اختيار بطارية مولد الديزل</a>
    </p>
  </div>
</BaseLayout>
