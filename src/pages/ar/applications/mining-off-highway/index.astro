---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما البطارية التي تستخدمها شاحنة التعدين؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تعمل شاحنات النقل التعدينية الكبيرة والمعدات خارج الطرق عادةً بأنظمة 24V مكوّنة من بطاريتين 12V للخدمة الشاقة على التوالي، بقدرة 850–1100+ CCA لتدوير محرك الديزل الكبير. ويتبع مقاس المجموعة السوق — JIS N150/N200 في آسيا، وDIN88/DIN100 في أوروبا — مع مطابقته دائمًا لقاعدة المعدة ومواصفة CCA."
      }
    },
    {
      "@type": "Question",
      "name": "لماذا تتعطل البطاريات أسرع في معدات التعدين؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "قد يقلل الاهتزاز الشديد والغبار وتقلبات الحرارة والتدوير العميق المتكرر من عمر خدمة البطارية بدرجة كبيرة مقارنة بمهمة التشغيل العادية على الطرق. وأبرز الأسباب: المثبّتات المرتخية والغبار الموصِّل على الأقطاب والتفريغ الجزئي المتكرر."
      }
    },
    {
      "@type": "Question",
      "name": "هل AGM أفضل من المغمورة للمعدات خارج الطرق؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم في معظم مهام خارج الطرق. فحصيرة AGM الزجاجية الماصة تقاوم الاهتزاز أفضل من المغمورة، ويمنع تصميمها المحكم فقدان الإلكتروليت على المنحدرات الشديدة ويحمي من الغبار الموصِّل، كما يلائم عمر دوراتها البالغ 600–1200 دورة (مقابل 200–300 للمغمورة) التدوير الأعمق الشائع في التعدين."
      }
    },
    {
      "@type": "Question",
      "name": "كم مرة ينبغي اختبار بطاريات المعدات خارج الطرق تحت الحمل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "مرتين سنويًا على الأقل، أكثر من الاختبار السنوي الموصى به لأساطيل الطرق. فظروف خارج الطرق القاسية تقصّ العمر بمقدار النصف، لذا يرصد اختبار الحمل نصف السنوي وفحص المثبّتات البطاريات المتراجعة قبل أي توقف."
      }
    }
  ]
};
---

<BaseLayout
  title="بطاريات التعدين والطرق الوعرة — تصنيع OEM من DINWEY"
  description="بطاريات للخدمة الشاقة لشاحنات التعدين والمعدات خارج الطرق — بنية مقاومة للاهتزاز وأنظمة 24V و850–1100+ CCA. تصنيع OEM معتمد وفق IATF 16949."
  jsonLd={faqJsonLd}
>
  <div class="container section">
    <nav aria-label="مسار التنقل" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/ar/" style="color:#1e5aa8;">الرئيسية</a> &rsaquo; التطبيقات &rsaquo; التعدين والطرق الوعرة
    </nav>
    <h1 style="color:#0f1f3d;">بطاريات شاحنات التعدين والمعدات خارج الطرق</h1>
    <p class="lead">
      تُعرّض الحفّارات وشاحنات النقل واللوادر ومنصات الحفر البطاريات لظروف تُتلف الوحدات
      العادية في أشهر — اهتزاز مستمر وغبار موصِّل ومنحدرات شديدة وتقلبات حرارة من قاع المنجم
      إلى السطح.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">النقاط الرئيسية</h2>
    <ol class="takeaways-list">
      <li><strong>مهام خارج الطرق تقصّر عمر البطارية</strong> — الاهتزاز الشديد والحرارة المرتفعة والغبار والتدوير الأعمق قد تقصّر عمر الخدمة بدرجة كبيرة مقارنة بمهمة التشغيل العادية على الطرق؛ والبنية المتينة وجدول اختبارات أكثر صرامة أمران لا تنازل عنهما.</li>
      <li><strong>تصميم AGM المحكم لا يقل أهمية عن مقاومته للاهتزاز</strong> — البطارية المغمورة المهوّاة تفقد الإلكتروليت على المنحدرات الشديدة وهي عرضة للغبار الموصِّل؛ وتزيل AGM المخاطرين معًا، بعمر دورات 600–1200 دورة مقابل 200–300 للمغمورة.</li>
      <li><strong>شاحنات النقل التعدينية الكبيرة تعمل أيضًا بـ 24V</strong> — بطاريتان 12V على التوالي بقدرة 850–1100+ CCA لمحرك الديزل الكبير، تُستبدلان كزوج متطابق (الطراز والعمر والتصنيف نفسهما).</li>
      <li><strong>افحص المثبّتات في كل صيانة، واختبر الحمل مرتين سنويًا على الأقل</strong> — الاهتزاز يُرخي الأقواس، وعادة الاختبار السنوي لا تكفي في مهام خارج الطرق.</li>
    </ol>

    <h2 style="color:#0f1f3d;margin-top:32px;">لماذا تحتاج معدات التعدين بطارية مختلفة</h2>
    <p>
      تجمع آلة موقع المنجم أسوأ ما في عدة بيئات. فالاهتزاز الناتج عن السير على أرض غير ممهدة
      وفوق صخور مفجّرة يهزّ الألواح ويُرخي الأقطاب. وقد يكوّن الغبار الموصِّل (من محطات التكسير
      ومناولة الخام) جسورًا بين الأقطاب المكشوفة ويستنزف البطارية ببطء. وتميل منحدرات طرق النقل
      الشديدة البطارية المغمورة وقد تكشف ألواحها. وفوق ذلك، تتيح فترات الخمول بين الورديات
      للبطارية أن تُفرّغ نفسها ذاتيًا بينما يُتوقع منها أن تدور مجددًا عند الطلب.
    </p>
    <p>
      والحل بطارية للخدمة الشاقة مصممة لهذه المهمة: ألواح Pb-Sb (رصاص-أنتيمون) سميكة تتحمل
      الدورات العميقة والاهتزاز، أو تصميم AGM محكم الإغلاق يتجنب مشكلتي فقدان الإلكتروليت
      والغبار في الوحدة المغمورة المهوّاة. وتورّد DINWEY النوعين — المغمورة JIS N150/N200
      وDIN88/DIN100 للميزانيات القياسية، وAGM حيث تبرر المهمة خيارًا خاليًا من الصيانة.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">المواصفات الموصى بها</h2>
    <table>
      <thead>
        <tr><th>المتطلب</th><th>المواصفة</th></tr>
      </thead>
      <tbody>
        <tr><td>جهد النظام</td><td>24V (بطاريتان 12V على التوالي) لشاحنات النقل الكبيرة؛ 12V للوحدات الأصغر</td></tr>
        <tr><td>أمبير التدوير البارد (CCA)</td><td>850–1100+ CCA (SAE J537) لمحركات الديزل الكبيرة</td></tr>
        <tr><td>مقاس المجموعة</td><td>JIS N150/N200 (آسيا/أفريقيا) أو DIN88/DIN100 (أوروبا)</td></tr>
        <tr><td>البنية</td><td>مغمورة بألواح سميكة (Pb-Sb) أو AGM محكمة الإغلاق</td></tr>
        <tr><td>عمر الدورات</td><td>توفّر AGM عمومًا قدرة تدوير أعلى من بطاريات التشغيل المغمورة التقليدية؛ ويختلف العمر الفعلي حسب عمق التفريغ والحرارة ومنحنى الشحن</td></tr>
        <tr><td>جدول الاختبار</td><td>اختبار حمل مرتين سنويًا على الأقل؛ فحص المثبّتات في كل صيانة</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      المواصفات نطاقات تمثيلية. تختلف قيم CCA والسعة والأبعاد الدقيقة حسب الآلة — تواصل معنا
      للحصول على ورقة بيانات مطابقة لمعداتك.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">خطوط المنتجات لمهام خارج الطرق</h2>
    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h3>JIS للخدمة الشاقة (N150/N200)</h3>
        <p>بطاريات مغمورة بألواح سميكة للآلات الكبيرة — 145G51 (N150) 900A CCA، و190H52 (N200) 1100A CCA.</p>
        <a href="/ar/products/jis-heavy-duty/">اعرض JIS للخدمة الشاقة ←</a>
      </div>
      <div class="card">
        <h3>AGM (خالية من الصيانة)</h3>
        <p>AGM محكمة الإغلاق تتحمل الاهتزاز للمنحدرات الشديدة والغبار الموصِّل — عمر 600–1200 دورة.</p>
        <a href="/ar/products/fleet/">اعرض الأساطيل وAGM ←</a>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">الأسئلة الشائعة</h2>
    <div class="faq-item">
      <h3>ما البطارية التي تستخدمها شاحنة التعدين؟</h3>
      <p>تعمل شاحنات النقل التعدينية الكبيرة والمعدات خارج الطرق عادةً بأنظمة 24V مكوّنة من بطاريتين 12V للخدمة الشاقة على التوالي، بقدرة 850–1100+ CCA لتدوير محرك الديزل الكبير. ويتبع مقاس المجموعة السوق — JIS N150/N200 في آسيا، وDIN88/DIN100 في أوروبا — مع مطابقته دائمًا لقاعدة المعدة ومواصفة CCA.</p>
    </div>
    <div class="faq-item">
      <h3>لماذا تتعطل البطاريات أسرع في معدات التعدين؟</h3>
      <p>قد يقلل الاهتزاز الشديد والغبار وتقلبات الحرارة والتدوير العميق المتكرر من عمر خدمة البطارية بدرجة كبيرة مقارنة بمهمة التشغيل العادية على الطرق. وأبرز الأسباب: المثبّتات المرتخية والغبار الموصِّل على الأقطاب والتفريغ الجزئي المتكرر.</p>
    </div>
    <div class="faq-item">
      <h3>هل AGM أفضل من المغمورة للمعدات خارج الطرق؟</h3>
      <p>نعم في معظم مهام خارج الطرق. فحصيرة AGM الزجاجية الماصة تقاوم الاهتزاز أفضل من المغمورة، ويمنع تصميمها المحكم فقدان الإلكتروليت على المنحدرات الشديدة ويحمي من الغبار الموصِّل، كما يلائم عمر دوراتها البالغ 600–1200 دورة (مقابل 200–300 للمغمورة) التدوير الأعمق الشائع في التعدين.</p>
    </div>
    <div class="faq-item">
      <h3>كم مرة ينبغي اختبار بطاريات المعدات خارج الطرق تحت الحمل؟</h3>
      <p>مرتين سنويًا على الأقل، أكثر من الاختبار السنوي الموصى به لأساطيل الطرق. فظروف خارج الطرق القاسية تقصّ العمر بمقدار النصف، لذا يرصد اختبار الحمل نصف السنوي وفحص المثبّتات البطاريات المتراجعة قبل أي توقف.</p>
    </div>

    <p style="margin-top:24px;">
      📚 اقرأ الدليل الكامل: <a href="https://docs.dinweysbattery.com/mining-off-highway/" target="_blank" rel="noopener">اختيار بطاريات التعدين والمعدات خارج الطرق</a>
    </p>
  </div>
</BaseLayout>
