const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What battery does a diesel generator use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Diesel generators use a starting battery matched to the engine's cranking requirement — often a heavy-duty flooded or AGM battery with 850–1100+ CCA. Larger generators may use 24V starting systems."
      }
    },
    {
      "@type": "Question",
      "name": "How is a generator battery different from a vehicle battery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The chemistry is identical; the duty is not. A vehicle battery is recharged daily by the alternator, while a generator battery sits idle and self-discharges 3–5% a month — 9–15% of a 135 Ah battery in three idle months — yet must still deliver high CCA on demand. A float charger, not the alternator, keeps it alive."
      }
    },
    {
      "@type": "Question",
      "name": "Why do standby generator batteries fail?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sulfation, not use. A battery that sits at a low state of charge for months self-discharges and progressively sulfates, losing capacity invisibly until the one cold night it must crank. A float charger or maintainer prevents it."
      }
    },
    {
      "@type": "Question",
      "name": "How often should I replace a generator battery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Generator batteries typically last 3–5 years, but standby units that sit idle need regular charging to avoid sulfation. Test annually and replace proactively before a critical start."
      }
    }
  ]
};
