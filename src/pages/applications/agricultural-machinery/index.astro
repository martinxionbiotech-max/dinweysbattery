---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What battery does agricultural machinery use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tractors, combines and harvesters run diesel engines, so they need a high-CCA starting battery — typically 12V on smaller tractors and 24V on larger machines built from two 12V batteries in series. Group size follows the machine, commonly JIS N150/N200 or DIN88/DIN100 depending on origin, matched to the tray and CCA specification."
      }
    },
    {
      "@type": "Question",
      "name": "Why do batteries fail during the off-season on farms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Agricultural machines sit idle for long periods between seasons, so batteries self-discharge while parked. A partially discharged battery left standing sulphates and loses capacity, and the first cold or heavy start of the new season is then too much for it. A maintenance routine or a charger during storage prevents this."
      }
    },
    {
      "@type": "Question",
      "name": "Is AGM better than flooded for farm equipment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AGM handles vibration and dust better than vented flooded designs and is sealed, which helps on rough fields and sloping ground. But flooded thick-plate batteries remain the standard, lower-cost choice where the duty is simple starting. The choice is conditional on the machine's duty and charging system."
      }
    },
    {
      "@type": "Question",
      "name": "How should I store a tractor battery over the off-season?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Keep it charged — a fully charged battery self-discharges more slowly and is far less prone to sulphation. Either disconnect and trickle-charge periodically, or use a maintenance charger during storage, and store the battery in a cool, dry place."
      }
    }
  ]
};
