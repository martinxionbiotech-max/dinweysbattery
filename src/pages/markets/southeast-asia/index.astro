<BaseLayout
  title="Truck Batteries for Southeast Asia — DINWEYS OEM"
  description="Heavy-duty truck batteries for Southeast Asian distributors — heat- and humidity-resistant JIS N150/N200, the region's core commercial battery. OEM supply from Chengguang Power Tech Co., Ltd."
  jsonLd={faqJsonLd}
