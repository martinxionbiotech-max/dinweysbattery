---
import BaseLayout from "../../layouts/BaseLayout.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About DINWEYS",
  "url": "https://dinweysbattery.com/about/",
  "mainEntity": { "@id": "https://dinweysbattery.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is DINWEYS a factory or a trading company?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DINWEYS is the truck and heavy-duty starting battery brand of Chengguang Power Tech Co., Ltd., a manufacturer founded in 2002 in Jinzhou City, Hebei, China. Batteries are produced end-to-end on the company's own 18 automated assembly lines rather than assembled from outsourced parts."
      }
    },
    {
      "@type": "Question",
      "name": "Where are DINWEYS batteries manufactured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At the Chengguang Power Tech Co., Ltd. facility in Jinzhou City, Shijiazhuang, Hebei Province, China — a 200,000 m² plant with 18 automated assembly lines. The facility figures are stated by the manufacturer and are not third-party audited."
      }
    },
    {
      "@type": "Question",
      "name": "What certifications does the factory hold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The plant operates under an IATF 16949 quality management system, and the manufacturer states ISO 9001:2015, ISO 14001:2015, ISO 45001:2018, OHSAS 18001 and CE marking. Certificate numbers, issuers and scope have not been published on this site yet — ask for them with your quotation."
      }
    },
    {
      "@type": "Question",
      "name": "Does DINWEYS offer OEM and private-label production?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. OEM and private-label supply are part of the product range; branding, packaging, documentation and batch test records are agreed per program. Tell us the group size, CCA and market, and we quote against your specification."
      }
    },
    {
      "@type": "Question",
      "name": "Which battery sizes does DINWEYS publish specifications for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Four first-party models: 145G51 (N150), 190H52 (N200), 58827 (DIN88) and 60038 (DIN100). BCI Group 31 / 8D is made to order, and six further group sizes (N70, N100, N120, N220, DIN66, DIN74) are listed as third-party reference only — not DINWEYS published stock ratings."
      }
    }
  ]
};
---

<BaseLayout
  title="About DINWEYS — Heavy-Duty Truck Battery Brand"
  description="DINWEYS is the truck and heavy-duty starting battery brand of Chengguang Power Tech Co., Ltd., a manufacturer founded in 2002 in Hebei, China."
  jsonLd={[aboutJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">About DINWEYS</h1>
    <p class="lead">
      DINWEYS is the truck and heavy-duty starting battery brand of Chengguang Power Tech Co., Ltd.,
      a manufacturer founded in 2002. We focus on one thing: starting batteries that hold up
      under the demands of commercial trucks — high cold cranking amps, vibration resistance,
      and consistent batch quality.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Our Focus</h2>
    <p>
      While many battery suppliers sell a broad catalog, DINWEYS concentrates on the truck and
      heavy-duty vertical. That focus lets us go deep on what matters to commercial-vehicle
      buyers: correct group sizes (JIS N150/N200, DIN88/DIN100; BCI Group 31/8D on request),
      diesel-grade CCA, and 12V vs 24V system requirements.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">The Factory Behind the Brand</h2>
    <p>
      DINWEYS is manufactured by Chengguang Power Tech Co., Ltd., a battery manufacturer established in 2002
      in Jinzhou City, Shijiazhuang, Hebei Province, China. The factory spans 200,000 m² with
      18 automated assembly lines, exporting to 70+ countries.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Inside the Factory</h2>
    <p class="lead" style="margin-bottom:16px;">
      A look inside the Chengguang Power Tech Co., Ltd. facility in Jinzhou, Hebei — 200,000 m², 18 automated
      assembly lines, and the production floor behind every DINWEYS battery.
    </p>
    <section class="factory-gallery" aria-label="Chengguang Power Tech Co., Ltd. factory">
      <div class="factory-slot">
        <img src="/images/factory/factory-01.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="655" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-02.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="499" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-03.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="502" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-04.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="502" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-05.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="503" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-06.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="509" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-07.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="508" loading="lazy" decoding="async" />
      </div>
      <div class="factory-slot">
        <img src="/images/factory/factory-08.jpg" alt="Chengguang Power Tech Co., Ltd. battery factory" width="1200" height="506" loading="lazy" decoding="async" />
      </div>
    </section>

    <h2 style="color:#0f1f3d;margin-top:32px;">How Batteries Are Made</h2>
    <p>
      Chengguang Power Tech Co., Ltd. controls the entire production chain in-house — from R&amp;D and
      plate manufacturing to assembly, testing and packaging. Each step runs under an integrated
      quality management system, so a DINWEYS battery is not assembled from outsourced parts but
      produced end-to-end on the same 18 automated lines.
    </p>
    <ol style="padding-left:22px;">
      <li><strong>Grid casting</strong> — the lead alloy grids that form each plate's structure.</li>
      <li><strong>Paste mixing</strong> — lead oxide paste is mixed to a controlled recipe.</li>
      <li><strong>Pasting</strong> — the paste is applied to the grids to form the plates.</li>
      <li><strong>Curing</strong> — plates are dried and hardened under controlled conditions.</li>
      <li><strong>Formation</strong> — the initial charge that converts the plates into active material.</li>
      <li><strong>Assembly</strong> — plates are welded into elements and stacked into cells.</li>
      <li><strong>Testing</strong> — CCA, capacity, leak and dimensional checks before packing.</li>
    </ol>
    <p class="data-note">
      Process detail sourced from Chengguang Power Tech Co., Ltd. production documentation
      under an IATF 16949 quality management system.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Quality Control &amp; Testing</h2>
    <p>
      Every DINWEYS batch is verified in five on-site laboratories before release:
    </p>
    <table>
      <thead>
        <tr><th>Laboratory</th><th>What it verifies</th></tr>
      </thead>
      <tbody>
        <tr><td>Chemical Lab</td><td>Raw material analysis, paste composition, electrolyte purity</td></tr>
        <tr><td>Physical Testing Lab</td><td>Plate strength, separator porosity, container integrity</td></tr>
        <tr><td>Electrical Testing Lab</td><td>CCA, reserve capacity, charge acceptance, high-rate discharge</td></tr>
        <tr><td>Life Cycle Testing</td><td>JIS/DIN/BCI standard cycle life, corrosion resistance, overcharge endurance</td></tr>
        <tr><td>Environmental Chamber</td><td>Temperature cycling (−40°C to +80°C), humidity, vibration</td></tr>
      </tbody>
    </table>
    <p style="margin-top:16px;">
      Five-stage quality control runs across the whole chain:
    </p>
    <ol style="padding-left:22px;">
      <li><strong>Incoming material inspection</strong> — lead ingots, sulfuric acid, polypropylene and separator materials are tested before production.</li>
      <li><strong>In-process QC</strong> — all 18 lines are monitored in real time for paste density, plate weight, welding integrity and electrolyte fill levels.</li>
      <li><strong>Finished product testing</strong> — every batch undergoes CCA, reserve capacity, charge acceptance, leak test and visual inspection.</li>
      <li><strong>Pre-shipment audit</strong> — random sampling per AQL standards; packaging, labelling and documentation verified.</li>
      <li><strong>Traceability</strong> — batch-level tracking from raw material to container, with full documentation for import compliance.</li>
    </ol>
    <p class="data-note">
      Laboratories, QC stages and documentation (COA, MSDS, inspection reports) are as published
      on the Chengguang Power Tech Co., Ltd. quality-certifications page. Third-party lab testing
      (SGS, TÜV, BV) is available at the buyer's request.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Certifications</h2>
    <p class="data-note">
      Held by the manufacturer, Chengguang Power Tech Co., Ltd. Certificate numbers and validity
      are available on request.
    </p>
    <table>
      <thead>
        <tr><th>Certification</th><th>Scope</th><th>Status</th></tr>
      </thead>
      <tbody>
        <tr><td>IATF 16949</td><td>Automotive Quality Management System</td><td>Held by manufacturer</td></tr>
        <tr><td>ISO 9001:2015</td><td>Quality Management System</td><td>Held by manufacturer</td></tr>
        <tr><td>ISO 14001:2015</td><td>Environmental Management</td><td>Held by manufacturer</td></tr>
        <tr><td>ISO 45001:2018</td><td>Occupational Health &amp; Safety</td><td>Held by manufacturer</td></tr>
        <tr><td>OHSAS 18001</td><td>Health &amp; Safety Management</td><td>Superseded by ISO 45001 (formerly held)</td></tr>
        <tr><td>CE Marking</td><td>European Conformity</td><td>Conformity per applicable directives</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      Certificate numbers, issuing bodies and validity are provided with quotations. Third-party
      lab testing (SGS, TÜV, BV) available at buyer's request.
    </p>
    <p class="data-note">
      Standards we follow:
      <a href="https://batterycouncil.org/" target="_blank" rel="noopener">Battery Council International (BCI)</a>
      for group sizing, and
      <a href="https://www.sae.org/" target="_blank" rel="noopener">SAE International</a>
      for the J537 cold-cranking-amp test.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">What Our Partners Value</h2>
    <p class="lead" style="margin-bottom:20px;">
      Themes that recur across the distributors, importers and fleet operators we supply in
      70+ countries.
    </p>
    <div class="testimonial">
      <blockquote>
        "Middle East distributors consistently highlight batch-to-batch consistency — every
