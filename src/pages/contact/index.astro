---
import BaseLayout from "../../layouts/BaseLayout.astro";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact DINWEYS",
  "url": "https://dinweysbattery.com/contact/",
  "mainEntity": { "@id": "https://dinweysbattery.com/#organization" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do you sell truck batteries to end customers or only in bulk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DINWEYS primarily supplies distributors, importers, fleet operators and OEM/private-label buyers in bulk. For trade inquiries, email martin@dinweys.com with your vehicle type, group size and target quantity."
      }
    },
    {
      "@type": "Question",
      "name": "What information should I include in my inquiry?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Include your vehicle type (light/medium/heavy truck or European commercial vehicle), the battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D), the system voltage (12V or 24V), and your target quantity and destination port."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer OEM and private label truck batteries?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. DINWEYS is the truck-battery brand of Chengguang Power Tech Co., Ltd. (founded 2002), a manufacturer supporting OEM and private-label programs with custom branding, packaging and specification, exported to 70+ countries."
      }
    }
  ]
};
---

<BaseLayout
  title="Contact DINWEYS — Truck Battery Inquiry"
  description="Contact DINWEYS for truck battery quotes, datasheets, OEM and private label programs. Email martin@dinweys.com or WhatsApp +86 13323237275."
  jsonLd={[contactJsonLd, faqJsonLd]}
>
  <div class="container section">
    <h1 style="color:#0f1f3d;">Contact &amp; Inquiry</h1>
    <p class="lead">
      For quotes, datasheets, OEM / private label programs or fleet supply, reach us directly.
      We respond to genuine trade inquiries — please include your vehicle type, required group
      size (if known) and target quantity.
    </p>

    <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
      <a class="cta" href="https://wa.me/8613323237275" target="_blank" rel="noopener" style="display:inline-block;background:#25D366;color:#fff;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">WhatsApp — Contact Now</a>
      <a class="cta" href="mailto:martin@dinweys.com" style="display:inline-block;background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">Email Us</a>
    </div>

    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3>Direct Contact</h3>
        <p>
          <strong>Contact:</strong> Martin Wong, Sales Director<br />
          <strong>Email:</strong> <a href="mailto:martin@dinweys.com">martin@dinweys.com</a><br />
          <strong>Phone / WhatsApp:</strong> <a href="tel:+8613323237275">+86 13323237275</a>
        </p>
      </div>
      <div class="card">
        <h3>Factory</h3>
        <p>
          Chengguang Power Tech Co., Ltd.<br />
          Lvjiaying Village, Mayu Industrial Park,<br />
          Jinzhou City, Shijiazhuang, Hebei, China
        </p>
      </div>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">How We Qualify Your Inquiry</h2>
    <p>
      To route you to the right answer quickly, we read every inquiry by intent:
    </p>
    <div style="overflow-x:auto;">
      <table>
        <thead>
          <tr><th>Intent</th><th>What you want</th><th>Fastest path</th></tr>
        </thead>
        <tbody>
          <tr><td>Research</td><td>Understand standards / sizing</td><td><a href="https://docs.dinweysbattery.com/" style="color:#1e5aa8;">Knowledge Hub</a></td></tr>
          <tr><td>Product interest</td><td>Browse a model family</td><td><a href="/batteries/" style="color:#1e5aa8;">Battery reference</a></td></tr>
          <tr><td>Specification request</td><td>Datasheet for one model</td><td><a href="/contact/" style="color:#1e5aa8;">Get Datasheet</a></td></tr>
          <tr><td>OEM / private label</td><td>Branded or custom batteries</td><td><a href="/products/fleet/" style="color:#1e5aa8;">OEM program</a></td></tr>
          <tr><td>RFQ</td><td>Bulk quote on a known spec</td><td>Form below</td></tr>
        </tbody>
      </table>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">Request a Quote (RFQ)</h2>
    <p class="data-note">
      Fill in what you know — leave unknown fields blank. A structured inquiry gets a faster,
      more accurate quotation. No pricing is published; quotes are provided on request.
    </p>
    <form id="rfq-form" style="margin-top:16px;">
      <div class="grid grid-2" style="gap:12px;">
        <div>
          <label for="rfq-type" style="display:block;font-weight:600;margin-bottom:4px;">Battery standard</label>
          <select id="rfq-type" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;">
            <option value="">Not sure</option>
            <option>JIS (N-series)</option>
            <option>DIN / EN</option>
            <option>BCI (Group 31 / 8D)</option>
            <option>Other / mixed</option>
          </select>
        </div>
        <div>
          <label for="rfq-model" style="display:block;font-weight:600;margin-bottom:4px;">Model / group size</label>
          <input id="rfq-model" type="text" placeholder="e.g. N150, DIN88, Group 31" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;" />
        </div>
        <div>
          <label for="rfq-existing" style="display:block;font-weight:600;margin-bottom:4px;">Existing battery (for matching)</label>
          <input id="rfq-existing" type="text" placeholder="e.g. currently using N150 / 145G51 / Group 31 — we'll match the DINWEYS equivalent" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;" />
        </div>
        <div>
          <label for="rfq-voltage" style="display:block;font-weight:600;margin-bottom:4px;">System voltage</label>
          <select id="rfq-voltage" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;">
            <option value="">Not sure</option>
            <option>12V</option>
            <option>24V</option>
          </select>
        </div>
        <div>
          <label for="rfq-application" style="display:block;font-weight:600;margin-bottom:4px;">Application</label>
          <select id="rfq-application" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;">
            <option value="">Select…</option>
            <option>Heavy truck / semi trailer</option>
            <option>Bus / coach</option>
            <option>Mining / off-highway</option>
            <option>Diesel generator</option>
            <option>Cold chain / refrigerated</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="rfq-qty" style="display:block;font-weight:600;margin-bottom:4px;">Target quantity</label>
          <input id="rfq-qty" type="text" placeholder="e.g. 1 × 20ft container (~600–800 units)" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;" />
        </div>
        <div>
          <label for="rfq-port" style="display:block;font-weight:600;margin-bottom:4px;">Country / destination port</label>
          <input id="rfq-port" type="text" placeholder="e.g. Jeddah, Saudi Arabia" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;" />
        </div>
        <div>
          <label for="rfq-oem" style="display:block;font-weight:600;margin-bottom:4px;">OEM / private label</label>
          <select id="rfq-oem" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;">
            <option value="">Not sure</option>
            <option>Yes — branded / private label</option>
            <option>No — standard DINWEYS product</option>
          </select>
        </div>
        <div>
          <label for="rfq-notes" style="display:block;font-weight:600;margin-bottom:4px;">Additional requirements (Ah / CCA / dimensions)</label>
          <input id="rfq-notes" type="text" placeholder="e.g. 135Ah, 900A CCA, 508×222×212mm" style="width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:6px;" />
        </div>
      </div>
      <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
        <button type="submit" class="cta" style="background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border:none;border-radius:6px;cursor:pointer;">Generate Inquiry Email</button>
        <a class="cta" href="https://wa.me/8613323237275" target="_blank" rel="noopener" style="display:inline-block;background:#25D366;color:#fff;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">WhatsApp Instead</a>
      </div>
      <p id="rfq-status" class="data-note" style="margin-top:12px;"></p>
    </form>
    <script>
      const rfqForm = document.getElementById('rfq-form');
      rfqForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const g = (id) => document.getElementById(id)?.value?.trim() || '';
        const lines = [
          'Battery standard: ' + (g('rfq-type') || 'Not specified'),
          'Model / group size: ' + (g('rfq-model') || 'Not specified'),
          'System voltage: ' + (g('rfq-voltage') || 'Not specified'),
          'Application: ' + (g('rfq-application') || 'Not specified'),
          'Target quantity: ' + (g('rfq-qty') || 'Not specified'),
          'Country / port: ' + (g('rfq-port') || 'Not specified'),
          'OEM / private label: ' + (g('rfq-oem') || 'Not specified'),
          'Additional requirements: ' + (g('rfq-notes') || 'None'),
        ];
        const subject = encodeURIComponent('RFQ — ' + (g('rfq-model') || 'Truck battery inquiry'));
        const body = encodeURIComponent(lines.join('\n'));
        window.location.href = 'mailto:martin@dinweys.com?subject=' + subject + '&body=' + body;
        document.getElementById('rfq-status').textContent = 'Inquiry email prepared — your email client should open. If not, email martin@dinweys.com directly.';
      });
    </script>

    <h2 style="color:#0f1f3d;margin-top:32px;">What to Include in Your Inquiry</h2>
    <ul>
      <li>Vehicle type (light / medium / heavy truck, or European commercial vehicle)</li>
      <li>Required battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D, etc.)</li>
      <li>Electrical system voltage (12V or 24V)</li>
      <li>Target quantity and destination port</li>
    </ul>

    <h2 style="color:#0f1f3d;margin-top:32px;">Who We Work With</h2>
    <p>
      We supply distributors and importers, fleet operators, and OEM / private-label brands
      worldwide. DINWEYS is the truck-battery brand of Chengguang Power Tech Co., Ltd., a manufacturer founded
      in 2002 with a 200,000 m² facility and 18 automated lines, certified IATF 16949 · ISO 9001 · ISO 14001 · ISO 45001 · CE conformity,
      exporting to 70+ countries.
    </p>

    <h2 style="color:#0f1f3d;margin-top:32px;">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>Do you sell truck batteries to end customers or only in bulk?</h3>
      <p>DINWEYS primarily supplies distributors, importers, fleet operators and OEM/private-label buyers in bulk. For trade inquiries, email martin@dinweys.com with your vehicle type, group size and target quantity.</p>
    </div>
    <div class="faq-item">
      <h3>What information should I include in my inquiry?</h3>
      <p>Include your vehicle type (light/medium/heavy truck or European commercial vehicle), the battery group size or standard (JIS N150/N200, DIN88/DIN100, BCI Group 31/8D), the system voltage (12V or 24V), and your target quantity and destination port.</p>
    </div>
    <div class="faq-item">
      <h3>Do you offer OEM and private label truck batteries?</h3>
      <p>Yes. DINWEYS is the truck-battery brand of Chengguang Power Tech Co., Ltd. (founded 2002), a manufacturer supporting OEM and private-label programs with custom branding, packaging and specification, exported to 70+ countries.</p>
    </div>

    <p style="margin-top:24px;">
      📚 Not sure which spec you need? Start with the
      <a href="https://docs.dinweysbattery.com/" style="color:#1e5aa8;">DINWEYS Knowledge Hub</a> —
      selection guides, CCA and JIS/DIN/BCI standards explained.
    </p>

    <div style="margin-top:24px;padding:16px 20px;background:#f4f7fb;border-radius:8px;">
      <h2 style="color:#0f1f3d;margin-top:0;">Before You Inquire</h2>
      <ul style="margin:0;padding-left:20px;">
        <li><a href="/selection-tool/" style="color:#1e5aa8;">Use the battery selection tool</a> to narrow your model</li>
        <li><a href="/batteries/" style="color:#1e5aa8;">Browse the battery model reference</a> (N150/N200/DIN88/DIN100)</li>
        <li><a href="/products/fleet/" style="color:#1e5aa8;">Fleet &amp; OEM / private-label programs</a></li>
        <li><a href="/products/jis-heavy-duty/" style="color:#1e5aa8;">JIS heavy-duty</a> · <a href="/products/din-heavy-duty/" style="color:#1e5aa8;">DIN heavy-duty</a></li>
      </ul>
    </div>

    <p style="margin-top:16px;">
      Standards referenced:
      <a href="https://batterycouncil.org/" target="_blank" rel="noopener" style="color:#1e5aa8;">Battery Council International (BCI)</a> ·
      <a href="https://www.sae.org/" target="_blank" rel="noopener" style="color:#1e5aa8;">SAE International (J537 CCA)</a>
    </p>
  </div>
</BaseLayout>
