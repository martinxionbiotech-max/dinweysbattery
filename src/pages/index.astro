---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What battery group size does my truck need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Heavy-duty trucks most commonly use JIS N150/N200 (models 145G51/190H52) or DIN88/DIN100 batteries depending on the market. North American vehicles use BCI Group 31 (available on request). Always confirm the group size printed on your existing battery or in the vehicle manual."
      }
    },
    {
      "@type": "Question",
      "name": "Do heavy-duty trucks use 12V or 24V systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most semi trucks and heavy commercial vehicles use 24V electrical systems (two 12V batteries wired in series), while light trucks and pickups use 12V systems. Check your vehicle specification before ordering."
      }
    },
    {
      "@type": "Question",
      "name": "How much CCA does a diesel truck battery need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Diesel engines need high cold cranking amps (CCA). Heavy-duty trucks commonly require 800–1100+ CCA depending on engine displacement and climate. Colder climates need higher CCA. Confirm the exact requirement in your vehicle manual."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer OEM and private label truck batteries?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. As the DINWEY brand of Chengguang Power Tech Co., Ltd. (founded 2002), we manufacture truck starting batteries for OEM and private label programs, including custom branding, packaging and specification."
      }
    }
  ]
};
---

<BaseLayout
  title="DINWEY | Truck & Heavy-Duty Starting Batteries"
  description="DINWEY truck & heavy-duty starting batteries — JIS N150/N200, DIN88/DIN100, EFB/AGM, made by Chengguang Power Tech (2002). OEM and private-label programs."
  jsonLd={faqJsonLd}
>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Truck Starting Batteries,<br />Built for the Long Haul.</h1>
          <p>
            DINWEY manufactures heavy-duty starting batteries for trucks and commercial
            vehicles — JIS N150/N200, DIN88/DIN100, and BCI Group 31 on request. Diesel-grade
            cold cranking amps, 12V &amp; 24V systems, and OEM / private label programs from a
            factory founded in 2002.
          </p>
          <div class="hero-actions">
            <a class="cta" href="/selection-tool/">Find Your Battery</a>
            <a class="cta cta-outline" href="/contact/">Get a Quote</a>
          </div>
        </div>
        <img
          class="hero-image"
          src="/images/factory/factory-01.jpg"
          alt="DINWEY Chengguang Power Tech Co., Ltd. battery factory — truck and heavy-duty battery production line"
          width="1200"
          height="655"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Key Takeaways</h2>
      <ol class="takeaways-list">
        <li><strong>Truck batteries are not bigger car batteries</strong> — diesel engines demand far higher cold cranking amps, vibration resistance and 24V series wiring; incorrect group size, inadequate CCA, poor maintenance and unsuitable duty-cycle selection are common causes of fleet starting-battery problems.</li>
        <li><strong>Three standards, three markets</strong> — JIS N150/N200 for Asia/Middle East/Africa, DIN88/DIN100 for Europe (MAN, Scania, Volvo, Mercedes), and BCI Group 31/8D for North America.</li>
        <li><strong>A 200,000 m² plant with 18 automated lines</strong> — manufactured by Chengguang Power Tech Co., Ltd. (founded 2002), not a trading company.</li>
        <li><strong>Full OEM and private-label scope</strong> — brand, packaging, specification and terminal type, for distributors, importers and brands worldwide.</li>
        <li><strong>IATF 16949 plus ISO 9001/14001/45001, exporting to 70+ countries</strong> — automotive supply-chain quality credentials, not marketing claims.</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Why a Truck Needs a Different Battery</h2>
      <p class="lead">
        Truck starting batteries are not bigger car batteries. Diesel engines demand far
        higher cold cranking amps, vibration resistance, and — in heavy commercial vehicles —
        24V series configurations. Choosing the wrong group size or CCA rating is a common cause
        of fleet breakdowns.
      </p>
      <div class="grid grid-3">
        <div class="card">
          <h3>Diesel-Grade CCA</h3>
          <p>High cold cranking amps to turn over large diesel engines in cold weather.</p>
        </div>
        <div class="card">
          <h3>Right Group Size</h3>
          <p>JIS N150/N200 or DIN88/DIN100 — matched to your vehicle's battery tray.</p>
        </div>
        <div class="card">
          <h3>12V &amp; 24V Systems</h3>
          <p>Light trucks and heavy commercial vehicles have different electrical systems.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Our Product Range</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>JIS N150 / N200</h3>
          <p>Heavy-duty thick-plate batteries for large trucks, buses and generators.</p>
          <a href="/products/jis-heavy-duty/">View JIS Heavy-Duty →</a>
        </div>
        <div class="card">
          <h3>DIN88 / DIN100</h3>
          <p>European-standard batteries for MAN, Scania, Volvo, Mercedes and more.</p>
          <a href="/products/din-heavy-duty/">View DIN Heavy-Duty →</a>
        </div>
        <div class="card">
          <h3>BCI Group 31 / 8D</h3>
          <p>North American group sizes, made-to-order via our BCI production line.</p>
          <a href="/products/bci-request/">BCI (on request) →</a>
        </div>
        <div class="card">
          <h3>24V Systems</h3>
          <p>Series-configured battery pairs for heavy trucks, semi trailers and buses.</p>
          <a href="/products/24v/">View 24V Systems →</a>
        </div>
