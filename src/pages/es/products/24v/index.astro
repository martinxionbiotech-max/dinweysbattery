      ["Vehículos típicos", "Camiones ligeros, pickups, camiones medianos", "Camiones pesados, semirremolques, autobuses"],
      ["Baterías", "Una de 12V (p. ej., N150/N200, DIN88/DIN100)", "Dos de 12V emparejadas en serie"]
    ]
  }}
  scenarios={[
    {
      title: "Tractocamiones y transporte pesado",
      body: "Los tractocamiones de larga distancia funcionan a 24V para que el motor de arranque obtenga el máximo par con una corriente manejable. Dos baterías N200 (190H52) en serie aportan la reserva de arranque en frío que necesita un diésel grande en una mañana fría."
    },
    {
      title: "Autobuses y autocares",
      body: "Los 24V soportan las fuertes cargas eléctricas de un autocar moderno — iluminación, climatización, puertas y telemática — manteniendo secciones de conductor prácticas a lo largo del chasis."
    },
    {
      title: "Vehículos militares y especiales",
      body: "Los 24V son comunes en vehículos militares y especiales por las mismas razones: potencia de arranque, capacidad de carga y componentes estandarizados que simplifican el mantenimiento de la flota."
    }
  ]}
  maintenance={[
    "Reemplace siempre ambas baterías de un par de 24V juntas y con modelos idénticos.",
    "Mantenga los terminales limpios y apretados en las dos baterías — una sola conexión deficiente desequilibra el par.",
    "Use un cargador de 24V o cargue cada batería de 12V por separado con un cargador de 12V.",
    "Iguale la tecnología de las baterías — no mezcle electrolito líquido y AGM en el mismo par en serie."
  ]}
  image={{ src: "/images/products/190H52-N200.jpg", alt: "Batería de camión de 12V DINWEYS 190H52 N200 utilizada en un par en serie de 24V", width: 1024, height: 1024 }}
  faq={[
    { q: "¿Por qué los camiones pesados usan 24V?", a: "Los sistemas de 24V reducen a la mitad la corriente para la misma potencia, lo que permite cables más finos y un arranque más fiable de motores diésel grandes." },
    { q: "¿Puedo reemplazar solo una batería de un par de 24V?", a: "Se recomienda encarecidamente reemplazar ambas baterías como un par emparejado para garantizar una carga equilibrada y toda la vida útil." },
    { q: "¿Cómo conecto dos baterías de 12V para obtener 24V?", a: "Conecte el terminal positivo de una batería con el terminal negativo de la otra; los terminales restantes proporcionan 24V en el conjunto." },
    { q: "¿Las baterías de 24V necesitan un cargador especial?", a: "Sí. Use un cargador apto para 24V o cargue cada batería de 12V por separado con un cargador de 12V." },
    { q: "¿Qué CCA necesitan los sistemas de 24V para camiones?", a: "Los camiones pesados de 24V suelen necesitar 850–1100+ CCA por batería, según el tamaño del motor y el clima. Confirme la cifra exacta en el manual de su vehículo." },
    { q: "¿Qué pasa si mezclo una batería vieja y una nueva en un par de 24V?", a: "El par se carga de forma desigual: la batería más fuerte se sobrecarga y la más débil queda subcargada, acortando la vida de ambas. Use siempre dos baterías idénticas, del mismo modelo, antigüedad y clasificación." },
    { q: "¿Puedo arrancar por puente un camión de 24V desde un vehículo de 12V?", a: "No directamente sobre todo el sistema de 24V. Los procedimientos de arranque por puente para sistemas de 24V varían según el vehículo; siga el procedimiento del fabricante y, si tiene dudas, cargue cada batería de 12V por separado o llame a un profesional." },
    { q: "¿Los sistemas de 24V usan una sola batería de 24V?", a: "La mayoría de los camiones pesados usan dos baterías de 12V en serie en lugar de una unidad única de 24V, porque las baterías de 12V están más disponibles y cada una puede repararse o sustituirse por separado. Existen unidades monolíticas de 24V, pero son menos comunes en camiones." }
  ]}
