const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE + "/es/" },
    { "@type": "ListItem", "position": 2, "name": "Aplicación por modelo de camión", "item": SITE + "/es/truck-models/" },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo encuentro la batería DINWEY correcta para el modelo de mi camión?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text":
          "Busque el modelo de su camión en la lista a continuación. Cada modelo listado muestra el grupo de batería OEM (p. ej., N150/N200) y el modelo DINWEY correspondiente (145G51/190H52). Estas son referencias sectoriales: confirme siempre el tamaño de grupo, la orientación de los terminales y las dimensiones de la bandeja de su vehículo antes de realizar un pedido.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Estas referencias de aplicación están confirmadas oficialmente por los fabricantes de vehículos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text":
          "No. Los grupos de batería provienen de guías de aplicación independientes para vehículos comerciales (Club Assist y Century Batteries). Son referencias sectoriales, no confirmaciones oficiales de DINWEY como OEM ni avales de los fabricantes de vehículos. Verifíquelas con la especificación de su vehículo.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Por qué el Isuzu F Series muestra «requiere consulta» en lugar de un modelo DINWEY?",
