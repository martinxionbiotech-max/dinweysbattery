          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión ligero / pickup (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Invierno frío</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 145G51 (N150)</td><td style="padding:10px;border-bottom:1px solid #ddd;">900 CCA</td><td style="padding:10px;border-bottom:1px solid #ddd;">135 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión ligero / pickup (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Ártico / frío extremo</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión mediano (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Suave / templado</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión mediano (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Invierno frío</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión mediano (12V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Ártico / frío extremo</td><td style="padding:10px;border-bottom:1px solid #ddd;">JIS 190H52 (N200)</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión de servicio pesado / tractocamión (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Suave / templado</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200) — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA cada una</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah cada una</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión de servicio pesado / tractocamión (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Invierno frío</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200) — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA cada una</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah cada una</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión de servicio pesado / tractocamión (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Ártico / frío extremo</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200) — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA cada una</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah cada una</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Autobús / autocar (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Suave / templado</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200) — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA cada una</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah cada una</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Autobús / autocar (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Invierno frío</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200) — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA cada una</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah cada una</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Autobús / autocar (24V)</td><td style="padding:10px;border-bottom:1px solid #ddd;">Ártico / frío extremo</td><td style="padding:10px;border-bottom:1px solid #ddd;">2× JIS 190H52 (N200) — 24V</td><td style="padding:10px;border-bottom:1px solid #ddd;">1100 CCA cada una</td><td style="padding:10px;border-bottom:1px solid #ddd;">200 Ah cada una</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión comercial europeo</td><td style="padding:10px;border-bottom:1px solid #ddd;">Suave / templado</td><td style="padding:10px;border-bottom:1px solid #ddd;">DIN 58827 (DIN88)</td><td style="padding:10px;border-bottom:1px solid #ddd;">800 A EN</td><td style="padding:10px;border-bottom:1px solid #ddd;">88 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión comercial europeo</td><td style="padding:10px;border-bottom:1px solid #ddd;">Invierno frío</td><td style="padding:10px;border-bottom:1px solid #ddd;">DIN 60038 (DIN100)</td><td style="padding:10px;border-bottom:1px solid #ddd;">870 A EN</td><td style="padding:10px;border-bottom:1px solid #ddd;">100 Ah</td></tr>
          <tr><td style="padding:10px;border-bottom:1px solid #ddd;">Camión comercial europeo</td><td style="padding:10px;border-bottom:1px solid #ddd;">Ártico / frío extremo</td><td style="padding:10px;border-bottom:1px solid #ddd;">DIN 60038 (DIN100)</td><td style="padding:10px;border-bottom:1px solid #ddd;">870 A EN</td><td style="padding:10px;border-bottom:1px solid #ddd;">100 Ah</td></tr>
