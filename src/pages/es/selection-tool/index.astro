        cold:   { model: "BCI Grupo 31", cca: "Bajo pedido", ah: "Bajo pedido", link: "/es/products/bci-request/" },
        arctic: { model: "BCI Grupo 31 / 8D", cca: "Bajo pedido", ah: "Bajo pedido", link: "/es/products/bci-request/" },
      },
    };

    // 应用场景 → 技术建议
    const dutyNote = {
      standard: "Tecnología: electrolito líquido (SLI) — económica para el arranque convencional.",
      "high-load": "Tecnología: EFB o AGM, más un banco auxiliar separado de ciclo profundo para proteger la batería de arranque.",
      "off-highway": "Tecnología: AGM — sellada y resistente a las vibraciones para servicio fuera de carretera.",
    };

    calc.addEventListener("click", () => {
      const r = rec[vehicle.value]?.[climate.value];
      if (r) {
        result.innerHTML =
          "<strong>Recomendado:</strong> " + r.model +
          "<br/>Amperios de arranque en frío: " + r.cca +
          "<br/>Capacidad: " + r.ah +
          "<br/>" + dutyNote[duty.value] +
          "<br/><br/><a href=\"" + r.link + "\" style=\"color:#1e5aa8;\">Ver esta batería →</a>" +
          "<br/><br/><em>Confirme la especificación final con el manual de su vehículo.</em>";
        result.style.display = "block";
      }
    });
  </script>
</BaseLayout>
