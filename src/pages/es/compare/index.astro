---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const SITE = "https://dinweysbattery.com";

const comparisons = [
  {
    href: "/es/compare/n150-vs-n200/",
    label: "JIS N150 vs N200: batería de servicio pesado para camión",
    models: "145G51 (N150) · 190H52 (N200)",
    desc: "La diferencia en tamaño, capacidad, CCA, capacidad de reserva y emparejamiento en 24V — con una guía de decisión para compradores de camiones del mercado JIS.",
  },
  {
    href: "/es/compare/din88-vs-din100/",
    label: "DIN88 vs DIN100: batería de servicio pesado para camión",
    models: "58827 (DIN88) · 60038 (DIN100)",
    desc: "Largo de la caja, capacidad, arranque en frío EN y capacidad de reserva — qué cambia realmente entre los dos tamaños DIN y cuándo la caja más grande es dinero desperdiciado.",
  },
  {
    href: "/es/compare/jis-vs-din-vs-bci/",
    label: "JIS vs DIN vs BCI: por qué el CCA no se puede comparar directamente",
    models: "JIS D5301 · EN 50342 · SAE J537 · DIN 43539",
    desc: "Las cuatro normas prueban el CCA a diferentes temperaturas y voltajes de corte, así que una clasificación JIS de 900 A y una clasificación EN de 900 A no son el mismo número.",
  },
  {
    href: "/es/compare/12v-vs-24v/",
    label: "Sistemas de batería de camión de 12V vs 24V: cómo funciona la conexión en serie",
    models: "12V individual · 24V = 2 × 12V en serie",
    desc: "Por qué los 24V usan dos baterías de 12V en serie, y por qué la conexión en serie suma voltaje pero no Ah — ni simplemente CCA.",
  },
  {
    href: "/es/compare/truck-battery-cca/",
    label: "Guía de CCA para baterías de camión: ¿cuánto CCA necesita un camión?",
    models: "Diésel vs gasolina · clima · tamaño del motor",
    desc: "Cómo el clima, la cilindrada del motor y el ciclo de trabajo determinan el requisito de CCA — y por qué sobreespecificar el CCA agrega costo sin agregar valor de instalación.",
  },
];

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "@id": SITE + "/es/compare/#list",
      "name": "Comparativas y guías de compra de baterías para camiones DINWEYS",
      "numberOfItems": comparisons.length,
      "itemListElement": comparisons.map((c, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": c.label,
        "url": SITE + c.href,
      })),
    },
  ],
};
---

<BaseLayout
  title="Comparativas y guías de compra de baterías para camiones"
  description="Comparativas de baterías para camiones DINWEYS: JIS N150 vs N200, DIN88 vs DIN100, normas JIS vs DIN vs BCI, sistemas de 12V vs 24V y cuánto CCA necesita realmente un camión."
  jsonLd={[collectionJsonLd]}
  canonical="/es/compare/"
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Comparar", url: "/es/compare/" }
  ]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#6b5a54;margin-bottom:16px;">
      <a href="/es/" style="color:#1e5aa8;">Inicio</a> &rsaquo; Comparar
    </nav>

    <h1 style="color:#0f1f3d;margin-bottom:12px;">Comparativas y guías de compra de baterías para camiones</h1>
    <p class="lead">
      Comparativas de modelo a modelo y de norma a norma, escritas para compradores y no para una
      hoja de especificaciones: qué cambia realmente entre dos tamaños, cómo se mide cada
      clasificación y dónde la capacidad o el CCA adicionales no le aportan nada. Cada cifra proviene
      de la referencia de especificaciones de DINWEYS o de las normas citadas en la página.
    </p>

    <div style="margin:20px 0;padding:16px 20px;background:#f4f7fb;border-left:4px solid #f5a623;border-radius:6px;">
      <h2 style="color:#0f1f3d;margin:0 0 10px;font-size:1.15rem;">Respuesta directa</h2>
      <p style="margin:0;">Estas guías comparan dos tamaños de modelo, dos normas o dos voltajes de sistema: JIS N150 vs N200, DIN88 vs DIN100, JIS vs DIN vs BCI, 12V vs 24V, y cuánto CCA necesita realmente un camión. Cada una indica qué cifras provienen de las especificaciones de modelos DINWEYS y cuáles de catálogos independientes.</p>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">Comparativas</h2>
    <ul style="list-style:none;padding:0;">
      {comparisons.map((c) => (
        <li style="margin-bottom:18px;padding:16px 18px;border:1px solid #e5e9f0;border-radius:8px;">
          <a href={c.href} style="color:#1e5aa8;font-weight:700;font-size:1.05rem;">{c.label}</a>
          <div style="color:#55606e;font-size:0.88rem;margin:4px 0;">{c.models}</div>
          <p style="margin:0;color:#334155;">{c.desc}</p>
        </li>
      ))}
    </ul>

    <div style="margin-top:32px;padding:20px;background:#f4f7fb;border-radius:8px;">
      <h2 style="color:#0f1f3d;margin-top:0;">Para profundizar</h2>
      <ul style="margin-bottom:0;">
        <li><a href="/es/batteries/" style="color:#1e5aa8;">Referencia de modelos de baterías DINWEYS (especificaciones completas)</a></li>
        <li><a href="/es/products/" style="color:#1e5aa8;">Resumen de líneas de productos</a></li>
        <li><a href="/es/selection-tool/" style="color:#1e5aa8;">Herramienta de selección de baterías</a></li>
      </ul>
    </div>

    <div style="margin-top:32px;display:flex;flex-wrap:wrap;gap:12px;">
      <a class="cta" href="/es/contact/" style="display:inline-block;background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">Consulte qué modelo se adapta a su camión</a>
      <a class="cta" href="https://wa.me/8613323237275" target="_blank" rel="noopener" style="display:inline-block;background:#25D366;color:#fff;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">WhatsApp — Contactar ahora</a>
    </div>
  </div>
</BaseLayout>
