    "worksFor": { "@id": SITE + "/#organization" }
  },
  "publisher": { "@id": SITE + "/#organization" },
  "datePublished": "2026-09-14",
  "dateModified": "2026-09-14",
  "mainEntityOfPage": { "@type": "WebPage", "@id": SITE + "/es/compare/truck-battery-cca/" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto CCA necesita una batería de camión?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depende del motor y del clima. Los motores diésel necesitan más CCA que los de gasolina porque la mayor compresión dificulta el arranque en frío, y los climas más fríos necesitan más CCA que los cálidos. Iguale el CCA al requisito de arranque en frío del motor y a la especificación OEM, no a un número más alto."
      }
    },
    {
      "@type": "Question",
      "name": "¿Un CCA más alto es siempre mejor para un camión?",
      "acceptedAnswer": {
        "@type": "Answer",
