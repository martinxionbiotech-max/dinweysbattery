---
import BaseLayout from "../../layouts/BaseLayout.astro";

const definedTermSetJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "https://dinweysbattery.com/batteries/#term-set",
  "name": "DINWEY Truck Battery Model Reference",
  "description": "A structured reference of DINWEY heavy-duty truck battery models across JIS and DIN standards, with verified specifications.",
  "hasDefinedTerm": [
    { "@type": "DefinedTerm", "name": "145G51", "termCode": "145G51", "url": "https://dinweysbattery.com/batteries/jis/n150/" },
    { "@type": "DefinedTerm", "name": "190H52", "termCode": "190H52", "url": "https://dinweysbattery.com/batteries/jis/n200/" },
    { "@type": "DefinedTerm", "name": "58827", "termCode": "58827", "url": "https://dinweysbattery.com/batteries/din/din88/" },
    { "@type": "DefinedTerm", "name": "60038", "termCode": "60038", "url": "https://dinweysbattery.com/batteries/din/din100/" }
  ]
};
const referenceListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "https://dinweysbattery.com/batteries/#reference-list",
  "name": "Third-party reference model specifications (not DINWEY stock lines)",
  "description": "Group sizes commonly cross-referenced in JIS/DIN markets. Values are compiled from independent catalogs and are not DINWEY published stock ratings.",
  "numberOfItems": 6,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "65D31R (N70)", "url": "https://dinweysbattery.com/batteries/jis/n70/" },
    { "@type": "ListItem", "position": 2, "name": "95E41R (N100)", "url": "https://dinweysbattery.com/batteries/jis/n100/" },
    { "@type": "ListItem", "position": 3, "name": "N120", "url": "https://dinweysbattery.com/batteries/jis/n120/" },
    { "@type": "ListItem", "position": 4, "name": "245H52 (N220)", "url": "https://dinweysbattery.com/batteries/jis/n220/" },
    { "@type": "ListItem", "position": 5, "name": "56638 (DIN66)", "url": "https://dinweysbattery.com/batteries/din/din66/" },
    { "@type": "ListItem", "position": 6, "name": "57412 (DIN74)", "url": "https://dinweysbattery.com/batteries/din/din74/" }
  ]
};
---

<BaseLayout
  title="DINWEY Truck Battery Models — JIS & DIN Reference"
  description="DINWEY truck battery models — 145G51 (N150), 190H52 (N200), 58827 (DIN88), 60038 (DIN100) with verified specs, plus third-party reference sizes."
  ogType="article"
  jsonLd={[definedTermSetJsonLd, referenceListJsonLd]}
  canonical="/batteries/"
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Battery Models", url: "/batteries/" }
  ]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/" style="color:#1e5aa8;">Home</a> &rsaquo; Battery Models
    </nav>

    <h1 style="color:#0f1f3d;margin-bottom:12px;">DINWEY Truck Battery Models</h1>
    <p class="lead">
      A structured reference of DINWEY's core heavy-duty truck battery models across JIS and
      DIN standards. Each model page carries its full specification — voltage, capacity, CCA,
      reserve capacity and dimensions — with the test standard each rating is measured against.
    </p>

    <div style="margin:20px 0;padding:16px 20px;background:#f4f7fb;border-left:4px solid #f5a623;border-radius:6px;">
      <h2 style="color:#0f1f3d;margin:0 0 10px;font-size:1.15rem;">Direct Answer</h2>
      <p style="margin:0;">DINWEY publishes full specifications for four stock models — 145G51 (N150), 190H52 (N200), 58827 (DIN88) and 60038 (DIN100). A further six group sizes appear below as <strong>third-party reference only</strong> — they are not DINWEY published stock ratings. Compare CCA only within one test standard, and fit by group size, terminal type, polarity and tray dimensions as well as by CCA and Ah.</p>
    </div>

    <div style="margin:24px 0;padding:16px 20px;background:#f4f7fb;border-left:4px solid #f5a623;border-radius:6px;">
      <p style="margin:0;">
        <strong>Important:</strong> JIS CCA, DIN EN cold-cranking and BCI (SAE) CCA are measured
        under different standards and are <strong>not directly comparable</strong>. Note the test
        standard on each model. Always confirm fit by group size, terminal type, polarity and tray
        dimensions against your vehicle manual.
      </p>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">JIS Heavy-Duty Models</h2>
    <div style="overflow-x:auto;">
      <table>
        <thead>
          <tr><th>Model</th><th>Group</th><th>Voltage</th><th>Capacity</th><th>CCA</th><th>Dimensions (L×W×H)</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="/batteries/jis/n150/" style="color:#1e5aa8;"><strong>145G51</strong></a></td>
            <td>N150</td><td>12V</td><td>135 Ah</td><td>900 A (JIS)</td><td>508×222×212 mm</td>
          </tr>
          <tr>
            <td><a href="/batteries/jis/n200/" style="color:#1e5aa8;"><strong>190H52</strong></a></td>
            <td>N200</td><td>12V</td><td>200 Ah</td><td>1100 A (JIS)</td><td>520×278×220 mm</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">DIN Heavy-Duty Models</h2>
    <div style="overflow-x:auto;">
      <table>
        <thead>
          <tr><th>Model</th><th>Group</th><th>Voltage</th><th>Capacity</th><th>EN Cold-Cranking</th><th>Dimensions (L×W×H)</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="/batteries/din/din88/" style="color:#1e5aa8;"><strong>58827</strong></a></td>
            <td>DIN88</td><td>12V</td><td>88 Ah</td><td>800 A (EN)</td><td>353×175×190 mm</td>
          </tr>
          <tr>
            <td><a href="/batteries/din/din100/" style="color:#1e5aa8;"><strong>60038</strong></a></td>
            <td>DIN100</td><td>12V</td><td>100 Ah</td><td>870 A (EN)</td><td>393×175×190 mm</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="color:#0f1f3d;margin-top:40px;">Reference Model Specifications (third-party)</h2>
    <p>
      The sizes below are widely used in JIS/DIN markets, but DINWEY does not publish them as stock ratings.
      Values are compiled from independent catalogs (listed on each model page) and vary between manufacturers —
      they are a starting point for cross-referencing a replacement, not a DINWEY specification.
    </p>
    <div style="overflow-x:auto;">
      <table>
        <thead>
          <tr><th>Model</th><th>Group</th><th>Voltage</th><th>Capacity</th><th>Cold-cranking</th><th>Dimensions (L×W×H)</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="/batteries/jis/n70/" style="color:#1e5aa8;"><strong>65D31R</strong></a></td>
            <td>N70</td><td>12V</td><td>70 Ah</td><td>580 A (JIS, reference)</td><td>306×173×225 mm</td>
          </tr>
          <tr>
            <td><a href="/batteries/jis/n100/" style="color:#1e5aa8;"><strong>95E41R</strong></a></td>
            <td>N100</td><td>12V</td><td>100 Ah</td><td>730 A (JIS, reference)</td><td>410×176×234 mm</td>
          </tr>
          <tr>
            <td><a href="/batteries/jis/n120/" style="color:#1e5aa8;"><strong>N120</strong></a></td>
            <td>N120</td><td>12V</td><td>120 Ah</td><td>820 A (JIS, reference)</td><td>505×183×240 mm</td>
          </tr>
          <tr>
            <td><a href="/batteries/jis/n220/" style="color:#1e5aa8;"><strong>245H52</strong></a></td>
            <td>N220</td><td>12V</td><td>220 Ah</td><td>1200 A (JIS, reference)</td><td>515×265×216 mm (total height 254 mm)</td>
          </tr>
          <tr>
            <td><a href="/batteries/din/din66/" style="color:#1e5aa8;"><strong>56638</strong></a></td>
            <td>DIN66</td><td>12V</td><td>66 Ah</td><td>not published — confirm</td><td>278×175×190 mm</td>
          </tr>
          <tr>
            <td><a href="/batteries/din/din74/" style="color:#1e5aa8;"><strong>57412</strong></a></td>
            <td>DIN74</td><td>12V</td><td>74 Ah</td><td>680 A (EN, reference)</td><td>278×175×190 mm</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="data-note">
      Reference specifications — <strong>not DINWEY published stock ratings</strong>. Confirm exact CCA, capacity,
      terminal type, polarity and tray dimensions before ordering. DINWEY stock lines are the four models in the
      tables above (145G51, 190H52, 58827, 60038).
    </p>

    <h2 style="color:#0f1f3d;margin-top:40px;">Comparisons &amp; Buying Guides</h2>
