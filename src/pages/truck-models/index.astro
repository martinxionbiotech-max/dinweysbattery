<BaseLayout
  title="Truck Model Battery Fitment — DINWEYS Heavy-Duty Reference"
  description="Find the DINWEYS battery for your truck model — Hino 700, Isuzu Giga, Volvo FH/FM, Scania R, MAN TGS/TGX, Mercedes Actros/Atego, DAF XF, Iveco Stralis, Fuso, UD Quon — with OEM battery group, fitment confidence and reference model."
  ogType="article"
  author="Martin Wong"
  datePublished="2026-09-07"
  dateModified="2026-09-23"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/" style="color:#1e5aa8;">Home</a> &rsaquo; Truck Model Fitment
    </nav>

    <h1 style="color:#0f1f3d;margin-bottom:12px;">Truck Model Battery Fitment Reference</h1>
    <p class="lead">
      Find the DINWEYS heavy-duty starting battery for your truck model. Below are the truck
      models for which independent fitment guides document a battery group, mapped to the
      corresponding DINWEYS model — with a confidence level for each reference.
    </p>

    <div style="margin:20px 0;padding:16px 20px;background:#f4f7fb;border-left:4px solid #f5a623;border-radius:6px;">
      <h2 style="color:#0f1f3d;margin:0 0 10px;font-size:1.15rem;">Direct Answer</h2>
      <p style="margin:0;">Fitment references below cover {vehicles.length} truck models across Hino, Isuzu, Volvo, Scania, MAN, Mercedes-Benz, DAF, Iveco, Mitsubishi Fuso and UD Trucks. Group sizes come from independent fitment guides — an industry reference, <strong>not OEM confirmation</strong>. Each listing shows its fitment confidence level; always match group size, terminal type, polarity and tray dimensions before ordering.</p>
    </div>

    <div style="margin:24px 0;padding:16px 20px;background:#fff8ec;border-left:4px solid #f5a623;border-radius:6px;">
      <p style="margin:0;">
        <strong>Disclaimer:</strong> {disclaimer}
      </p>
    </div>

    <div style="margin:24px 0;padding:16px 20px;background:#f4f7fb;border:1px solid #e3e8ef;border-radius:8px;">
      <h2 style="color:#0f1f3d;margin:0 0 10px;font-size:1.15rem;">Fitment Confidence Levels</h2>
      <ul style="margin:0;padding-left:20px;">
        {confidenceLevels.map((c) => (
          <li style="margin-bottom:6px;"><strong>{c.level}</strong> — {c.definition}</li>
        ))}
      </ul>
      <p class="data-note" style="margin:8px 0 0;">
        These levels describe how the reference was sourced, not an OEM guarantee. A battery shown as a
        <strong>compatible reference</strong> is not an <strong>OEM replacement</strong> until it is confirmed
        against the vehicle's own specification.
      </p>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">Models With Verified Fitment Reference</h2>

    {
      vehicles.map((v) => (
        <div class="fitment-card" style="margin:24px 0;padding:20px 24px;background:#ffffff;border:1px solid #e3e8ef;border-radius:8px;">
          <h3 style="color:#0f1f3d;margin:0 0 4px;">
            {v.brand} {v.model}
            {v.generation && <span style="font-weight:400;font-size:0.85rem;color:#55606e;"> — {v.generation}</span>}
          </h3>
          <p style="margin:0 0 12px;color:#55606e;font-size:0.95rem;">
            {v.year && <>{v.year} · </>}{v.electricalSystem} system ({v.batteryQuantity} batteries in series)
          </p>

          <table style="margin-bottom:12px;">
            <thead>
              <tr><th>Field</th><th>Value</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>OEM battery group</td>
                <td><strong>{v.batteryGroup}</strong>{v.oemBattery ? ` (${v.oemBattery})` : ""}</td>
              </tr>
              <tr>
                <td>DINWEYS compatible reference</td>
                <td>
                  {v.dinweyRecommendation ? (
                    <strong>{v.dinweyRecommendation}</strong>
                  ) : (
                    <em style="color:#c0392b;">No direct DINWEYS model — needs inquiry</em>
                  )}
                </td>
              </tr>
              <tr>
                <td>Fitment confidence</td>
                <td><strong>{v.confidence}</strong> — {confidenceNote[v.confidence]}</td>
              </tr>
            </tbody>
          </table>

          {!v.needsInquiry && v.recommendationLinks.length > 0 && (
            <p style="margin:0 0 12px;">
              <strong>DINWEYS model pages:</strong>{" "}
              {v.recommendationLinks.map((l, i) => (
                <>
                  {i > 0 && " · "}
                  <a href={l.href} style="color:#1e5aa8;">{l.label}</a>
                </>
              ))}
            </p>
          )}

          {v.needsInquiry && (
            <div style="padding:12px 16px;background:#fdf2f2;border-left:4px solid #c0392b;border-radius:6px;margin-bottom:12px;">
              <p style="margin:0;">
                <strong>Needs inquiry:</strong>{" "}
                {v.inquiryNote
                  ? v.inquiryNote
                  : <>This model uses the JIS {v.batteryGroup} group, which is not currently in the DINWEYS standard product line.{" "}</>}
                <a href="/contact/" style="color:#1e5aa8;">Contact DINWEYS</a> to confirm whether a
                compatible or custom solution is available.
              </p>
            </div>
          )}

          <p class="data-note" style="margin:0;">
            Fitment evidence: {v.fitmentEvidence} — {v.source}.
          </p>
        </div>
      ))
    }

