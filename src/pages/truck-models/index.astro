const SITE = "https://dinweysbattery.com";

// 免责声明（每个 fitment 页面必须标注）
const disclaimer =
  "Industry reference, not DINWEYS official OEM confirmation. Battery groups listed below are sourced from independent commercial-vehicle fitment guides (Club Assist Commercial Fitment Guide and Century Batteries Selection Guide). Always confirm group size, terminal type, terminal orientation, polarity and tray dimensions against your specific vehicle before ordering.";

// §11 四级置信度定义
const confidenceLevels = [
  { level: "HIGH", definition: "Multiple credible sources or manufacturer documentation" },
  { level: "MEDIUM", definition: "Credible independent source with matching technical parameters" },
  { level: "LOW", definition: "Limited third-party reference" },
  { level: "UNVERIFIED", definition: "Insufficient evidence" },
];

// §28/§36 用词：compatible reference，而非 OEM replacement
