};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between CCA and amp-hours (Ah)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CCA measures the short burst of current that starts a cold engine; amp-hours (Ah) measure how much total energy the battery stores. A battery can be strong at one and weak at the other, so a datasheet should list both."
      }
    },
    {
      "@type": "Question",
      "name": "Is CCA or Ah more important for a truck battery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the duty. Cold-climate starting and high-compression diesel engines need CCA; engine-off loads such as sleeper-cab electronics, liftgates and refrigeration need Ah and reserve capacity. Match each rating to the job, not to a single headline number."
      }
    },
    {
      "@type": "Question",
      "name": "Is reserve capacity the same as amp-hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Reserve capacity is minutes at a fixed 25 A load until voltage drops below 10.5 V; amp-hours is total energy at a specified discharge rate. Converting RC minutes to Ah (25 A × minutes ÷ 60) is an estimate, not the rated capacity."
      }
    }
