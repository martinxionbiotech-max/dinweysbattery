  "description": "12V vs 24V truck electrical systems — why 24V uses two 12V batteries in series, and why series wiring adds voltage but not Ah and not simply CCA. A buyer's guide.",
  "image": SITE + "/images/products/145G51-N150.jpg",
  "author": {
    "@type": "Person",
    "name": "Martin Wong",
    "jobTitle": "Sales Director",
    "worksFor": { "@id": SITE + "/#organization" }
  },
  "publisher": { "@id": SITE + "/#organization" },
  "datePublished": "2026-09-13",
  "dateModified": "2026-09-13",
  "mainEntityOfPage": { "@type": "WebPage", "@id": SITE + "/compare/12v-vs-24v/" }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do two 12V batteries in series double the Ah?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. In series the voltage doubles to 24V but the amp-hour (Ah) capacity stays the same — two 12V 200Ah batteries in series make a 24V 200Ah bank. Only the stored energy (Wh) doubles, because voltage doubled."
      }
    },
    {
      "@type": "Question",
      "name": "Does series wiring double the CCA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not simply. Series wiring keeps the current path shared, so the bank's CCA is not 2× a single battery. The bank is limited by the weaker of the two units, which is why the two batteries should be identical and replaced together."
      }
