---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { localeFromPath, localizePath, t } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  lang?: string;
  dir?: string;
  /** schema.org page node type: WebPage | ItemPage | CollectionPage | AboutPage | ContactPage */
  pageType?: string;
  /** breadcrumb trail (Home first). Omit to keep the default Home › page breadcrumb. */
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description = "DINWEY is a truck & heavy-duty starting battery brand — JIS N150/N200, DIN88/DIN100, EFB and AGM. Manufactured by Chengguang Power Tech Co., Ltd. (founded 2002). OEM and private label programs.",
  canonical,
  ogType = "website",
  ogImage = "/images/og-default.jpg",
  jsonLd,
  author,
  datePublished,
  dateModified,
  noindex = false,
  lang = "en",
  dir = "ltr",
  pageType = "WebPage",
  breadcrumbs,
} = Astro.props;

const SITE = "https://dinweysbattery.com";
const pathLocale = localeFromPath(Astro.url.pathname);
const htmlLang = pathLocale;
const htmlDir = pathLocale === "ar" ? "rtl" : "ltr";
const ogLocale = pathLocale === "ar" ? "ar_SA" : pathLocale === "es" ? "es_ES" : "en_US";
const BRAND = "DINWEY";
const BRAND_FULL = "DINWEY — Truck & Heavy-Duty Starting Batteries";

// 标题规范化
const cleanTitle = title.replace(/\u200b/gi, "").trim();
const hasBrand = cleanTitle.toUpperCase().includes("DINWEY");
const baseTitle = cleanTitle || BRAND_FULL;
const fullTitle = hasBrand ? baseTitle : `${baseTitle} | ${BRAND}`;

const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : SITE + canonical)
  : SITE + Astro.url.pathname;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Article schema（EEAT：作者 + 日期 + 发布者）
const articleJsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: cleanTitle,
        description,
        image: ogImage.startsWith("http") ? ogImage : SITE + ogImage,
        author: {
          "@type": "Person",
          name: author || "Martin Wong",
          jobTitle: "Sales Director",
          worksFor: {
            "@type": "Organization",
            name: "Chengguang Power Tech Co., Ltd.",
            url: "https://chengguangenergy.com"
          },
          url: SITE + "/about/"
        },
        publisher: { "@id": SITE + "/#organization" },
        datePublished: datePublished,
        dateModified: dateModified || datePublished,
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl }
      }
    : null;

// Organization 实体 schema（DINWEY 品牌 + Chengguang Power Tech Co., Ltd. 母公司）
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE + "/#organization",
  "name": "DINWEY",
  // 站级退货政策（Google：标准退货政策放在 Organization 上，供商品/商家信息复用）
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": 30,
    "returnMethod": "https://schema.org/ReturnByMail",
    "merchantReturnLink": SITE + "/return-policy/"
  },
  "legalName": "DINWEY (brand of Chengguang Power Tech Co., Ltd.)",
  "url": SITE,
  "logo": SITE + "/images/logo.png",
  "brand": { "@type": "Brand", "name": "DINWEY" },
  "manufacturer": { "@id": SITE + "/#manufacturer" },
  "parentOrganization": { "@id": SITE + "/#manufacturer" },
  "foundingDate": "2002",
  "email": "martin@dinweys.com",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "email": "martin@dinweys.com",
    "url": "https://wa.me/8613323237275",
    "areaServed": "Worldwide",
    "availableLanguage": ["English", "Chinese", "Arabic", "Spanish"]
  },
  "areaServed": "Worldwide",
  "knowsAbout": [
    "Truck starting batteries",
    "Heavy-duty battery",
    "JIS battery (145G51, 190H52)",
    "DIN battery (58827, 60038)",
    "Cold Cranking Amps (CCA)",
    "SLI battery",
    "EFB battery",
    "AGM battery",
    "24V truck electrical systems",
    "Commercial vehicle battery"
  ]
};

const manufacturerJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE + "/#manufacturer",
  "name": "Chengguang Power Tech Co., Ltd.",
  "legalName": "Chengguang Power Tech Co., Ltd.",
  "url": "https://chengguangenergy.com",
  "foundingDate": "2002",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Lvjiaying Village, Mayu Industrial Park, Jinzhou City",
    "addressLocality": "Jinzhou",
    "addressRegion": "Hebei",
    "addressCountry": "CN"
  },
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "name": "IATF 16949" },
    { "@type": "EducationalOccupationalCredential", "name": "ISO 9001:2015" },
    { "@type": "EducationalOccupationalCredential", "name": "ISO 14001:2015" },
    { "@type": "EducationalOccupationalCredential", "name": "ISO 45001:2018" },
    { "@type": "EducationalOccupationalCredential", "name": "OHSAS 18001" },
    { "@type": "EducationalOccupationalCredential", "name": "CE Marking" }
  ]
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE + "/#website",
  "url": SITE,
  "name": BRAND_FULL,
  "publisher": { "@id": SITE + "/#organization" }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": canonicalUrl.replace(/\/$/, "") + "/#breadcrumb",
  "itemListElement": [
    ...(breadcrumbs && breadcrumbs.length > 0
      ? breadcrumbs.map((b, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": b.name,
          "item": b.url.startsWith("http") ? b.url : SITE + b.url,
        }))
      : [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE + "/" },
          ...(canonicalUrl !== SITE + "/"
            ? [{ "@type": "ListItem", "position": 2, "name": cleanTitle, "item": canonicalUrl }]
            : []),
        ]),
  ],
};

// 页面级实体（WebPage / ItemPage / CollectionPage …）——全站每页都有，保证面包屑与 isPartOf 不悬空
const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": pageType,
  "@id": canonicalUrl.replace(/\/$/, "") + "/#webpage",
  "url": canonicalUrl,
  "name": cleanTitle,
  "description": description,
  "isPartOf": { "@id": SITE + "/#website" },
  "inLanguage": htmlLang,
  "primaryImageOfPage": ogImage.startsWith("http") ? ogImage : SITE + ogImage,
  "publisher": { "@id": SITE + "/#organization" },
  ...(canonicalUrl !== SITE + "/"
    ? { "breadcrumb": { "@id": canonicalUrl.replace(/\/$/, "") + "/#breadcrumb" } }
    : {}),
  ...(datePublished ? { "datePublished": datePublished } : {}),
  ...(dateModified ? { "dateModified": dateModified } : {}),
};
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex" : "max-image-preview:large"} />
    {author && <meta name="author" content={author} />}

    <meta property="og:site_name" content={BRAND_FULL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <link rel="alternate" hreflang="en" href={SITE + localizePath(Astro.url.pathname, "en")} />
    <link rel="alternate" hreflang="ar" href={SITE + localizePath(Astro.url.pathname, "ar")} />
    <link rel="alternate" hreflang="es" href={SITE + localizePath(Astro.url.pathname, "es")} />
    <link rel="alternate" hreflang="x-default" href={SITE + localizePath(Astro.url.pathname, "en")} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />

    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    {jsonLdArray.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(manufacturerJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(pathLocale, "layout.skip")}</a>
    <Header />
    <main id="main">
      <slot />
      <div class="container" style="margin-top:40px;padding:16px 0;border-top:1px solid #e5e9f0;font-size:0.85rem;color:#475569;">
        <p style="margin:0;">{t(pathLocale, "layout.techReview").replace("DINWEY", BRAND)}</p>
      </div>
    </main>
    <Footer />
  </body>
</html>
