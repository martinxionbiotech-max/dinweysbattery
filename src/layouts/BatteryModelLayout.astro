---
import BaseLayout from "./BaseLayout.astro";
import { PUBLIC_LIST_PRICE } from "../data/pricing";

interface Props {
  model: string;          // e.g. "145G51"
  groupLabel: string;     // e.g. "N150"
  standard: string;       // e.g. "JIS"
  productName: string;    // full product name
  description: string;
  voltage: string;        // "12V"
  ah: string;             // "135 Ah"
  cca: string;            // "900 A"
  testStandard: string;   // "JIS D5301" / "EN 50342" / "SAE J537"
  rc: string;             // "220 min"
  dimensions: string;     // "508×222×212 mm"
  terminal: string | null;
  technology: string;
  applications: string[];
  intro: string[];
  specNotes: string[];
  takeaways?: string[];
  faq: { q: string; a: string }[];
  relatedDocs?: { title: string; url: string }[];
  complianceNote: string; // fitment 合规措辞
  siblingModels: { href: string; label: string }[];
  parentCategory: { href: string; label: string };
  isReference?: boolean; // true = 第三方参考型号，非 DINWEY 一手发布规格
}

const {
  model,
  groupLabel,
  standard,
  productName,
  description,
  voltage,
  ah,
  cca,
  testStandard,
  rc,
  dimensions,
  terminal,
  technology,
  applications,
  intro,
  specNotes,
  takeaways = [],
  faq,
  relatedDocs = [],
  complianceNote,
  siblingModels,
  parentCategory,
  isReference = false
} = Astro.props;

const pageTitle = `${model} (${groupLabel}) — ${standard} Heavy-Duty Truck Battery`;
const ogImage = "/images/og-default.jpg";
const pageUrl = Astro.url.pathname;
const SITE = "https://dinweysbattery.com";

// DefinedTerm schema（V2.0 AIO 增强：术语实体标记）
const definedTermJsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": `${SITE}${pageUrl}#defined-term`,
  "name": model,
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "name": "DINWEY Truck Battery Model Reference",
    "url": "https://dinweysbattery.com/batteries/"
  },
  "termCode": model
};

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${SITE}${pageUrl}#product`,
  "name": productName,
  "description": description,
  "image": SITE + ogImage,
  "url": `${SITE}${pageUrl}`,
  "model": model,
  // sku 只写一手发布的型号码；reference 型号（第三方目录规格）不写，避免虚假标识
  ...(isReference ? {} : { "sku": model }),
  "brand": { "@type": "Brand", "name": "DINWEY" },
  "manufacturer": { "@id": SITE + "/#manufacturer" },
  "category": "Truck starting battery (SLI)",
  "mainEntityOfPage": { "@id": `${SITE}${pageUrl.replace(/\/$/, "")}/#webpage` },
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Truck OEMs, fleet operators, battery distributors and importers"
  },
  // 价格：GSC「应指定 price 或 priceSpecification.price（在 offers 中）」+ 商家信息同款要求。
  // price 与 priceSpecification 同时给出（两条路径都满足）；
  // 页面规格表显示同一价格（PUBLIC_LIST_PRICE），schema 与可见内容一致。
  "offers": {
    "@type": "Offer",
    "@id": `${SITE}${pageUrl}#offer`,

    "price": PUBLIC_LIST_PRICE.amount,

    "priceCurrency": PUBLIC_LIST_PRICE.currency,

    "priceSpecification": {

      "@type": "UnitPriceSpecification",

      "price": PUBLIC_LIST_PRICE.amount,

      "priceCurrency": PUBLIC_LIST_PRICE.currency

    },
    "url": `${SITE}/contact/`,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "businessFunction": "http://purl.org/goodrelations/v1#Sell",
    "seller": { "@id": SITE + "/#organization" }
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Standard", "value": standard },
    { "@type": "PropertyValue", "name": "Group", "value": groupLabel },
    { "@type": "PropertyValue", "name": "Voltage", "value": voltage },
    { "@type": "PropertyValue", "name": "Capacity (C20)", "value": ah },
    { "@type": "PropertyValue", "name": "CCA", "value": cca },
    { "@type": "PropertyValue", "name": "Test Standard", "value": testStandard },
    { "@type": "PropertyValue", "name": "Reserve Capacity", "value": rc },
    { "@type": "PropertyValue", "name": "Dimensions", "value": dimensions }
  ],
  ...(isReference
    ? { "disambiguatingDescription": "Third-party reference specification compiled from independent catalogs — not a DINWEY published stock rating." }
    : {})
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  jsonLd={[definedTermJsonLd, productJsonLd, faqJsonLd]}
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: parentCategory.label, url: parentCategory.href },
    { name: `${model} (${groupLabel})`, url: pageUrl }
  ]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href="/" style="color:#1e5aa8;">Home</a> &rsaquo;
      <a href={parentCategory.href} style="color:#1e5aa8;">{parentCategory.label}</a> &rsaquo;
      {model} ({groupLabel})
    </nav>

    <h1 style="color:#0f1f3d;margin-bottom:8px;">{productName}</h1>
    <p style="color:#55606e;font-size:1.1rem;">Model {model} · {standard} Group {groupLabel} · {voltage} · {ah} · {cca} CCA</p>
    <p class="lead">{description}</p>

    {takeaways.length > 0 && (
      <div style="margin:20px 0;padding:16px 20px;background:#f4f7fb;border-left:4px solid #f5a623;border-radius:6px;">
        <h2 style="color:#0f1f3d;margin:0 0 10px;">Key Takeaways</h2>
        <ul style="margin:0;padding-left:20px;">
          {takeaways.map((t) => (
            <li style="margin-bottom:6px;">{t}</li>
          ))}
        </ul>
      </div>
    )}

    <div style="margin-top:16px;">
      {intro.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">Technical Specification</h2>
    <table>
      <thead>
        <tr><th>Specification</th><th>Value</th></tr>
      </thead>
      <tbody>
              <tr><td><strong>Indicative unit price</strong></td><td>{PUBLIC_LIST_PRICE.display} {PUBLIC_LIST_PRICE.note}</td></tr>
        <tr><td>DINWEY Model</td><td>{model}</td></tr>
        <tr><td>Group</td><td>{groupLabel}</td></tr>
        <tr><td>Standard</td><td>{standard}</td></tr>
        <tr><td>Voltage</td><td>{voltage}</td></tr>
        <tr><td>Capacity (C20)</td><td>{ah}</td></tr>
        <tr><td>Cold Cranking Amps (CCA)</td><td>{cca}</td></tr>
        <tr><td>Test Standard</td><td>{testStandard}</td></tr>
        <tr><td>Reserve Capacity (RC)</td><td>{rc}</td></tr>
        <tr><td>Dimensions (L×W×H)</td><td>{dimensions}</td></tr>
        {terminal && <tr><td>Terminals</td><td>{terminal}</td></tr>}
        <tr><td>Technology</td><td>{technology}</td></tr>
      </tbody>
    </table>
    <p class="data-note">
      {isReference
        ? 'Third-party reference specification — NOT a DINWEY published stock rating. Values are compiled from independent catalogs and vary by manufacturer; confirm exact CCA, capacity and dimensions before replacement.'
        : 'Specifications are representative for this model. Exact CCA, capacity and dimensions are confirmed per batch on the certificate of analysis — contact us for a full datasheet.'}
    </p>

    {specNotes.length > 0 && (
      <div style="margin-top:28px;">
        <h2 style="color:#0f1f3d;">Understanding This Model's Specifications</h2>
        {specNotes.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    <h2 style="color:#0f1f3d;margin-top:32px;">Typical Applications</h2>
    <ul>
      {applications.map((a) => (
        <li>{a}</li>
      ))}
    </ul>

    <div style="margin-top:28px;padding:16px 20px;background:#fff8ec;border:1px solid #f5a623;border-radius:6px;">
      <h2 style="color:#0f1f3d;margin-top:0;">Vehicle Fitment</h2>
      <p>{complianceNote}</p>
    </div>

    <h2 style="color:#0f1f3d;margin-top:32px;">Frequently Asked Questions</h2>
    {faq.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}

    <div style="margin-top:32px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
      <a class="cta" href="/contact/" style="display:inline-block;background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">{isReference ? 'Confirm ' + model + ' Specification & Availability' : 'Request ' + model + ' Datasheet & Quote'}</a>
      <a class="cta" href="https://wa.me/8613323237275" target="_blank" rel="noopener" style="display:inline-block;background:#25D366;color:#fff;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">WhatsApp — Contact Now</a>
    </div>

    {siblingModels.length > 0 && (
      <div style="margin-top:32px;">
        <h2 style="color:#0f1f3d;">Compare With Other Models</h2>
        <ul>
          {siblingModels.map((s) => (
            <li><a href={s.href} style="color:#1e5aa8;">{s.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    {relatedDocs.length > 0 && (
      <div style="margin-top:32px;padding:20px;background:#f4f7fb;border-radius:8px;">
        <h2 style="color:#0f1f3d;margin-top:0;">Related Technical Documentation</h2>
        <ul style="margin-bottom:0;">
          {relatedDocs.map((d) => (
            <li><a href={d.url} target="_blank" rel="noopener" style="color:#1e5aa8;">{d.title}</a></li>
          ))}
        </ul>
        <p class="data-note" style="margin-top:12px;">From the <a href="https://docs.dinweysbattery.com/" target="_blank" rel="noopener">DINWEY Knowledge Hub</a>.</p>
      </div>
    )}
  </div>
</BaseLayout>
