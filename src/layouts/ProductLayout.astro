---
import BaseLayout from "./BaseLayout.astro";
import { localeFromPath, localizePath, t } from "../i18n/ui";
import { PUBLIC_LIST_PRICE } from "../data/pricing";

interface ProductImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface ComparisonTable {
  headers: string[];
  rows: string[][];
}

interface Scenario {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  specTable: { spec: string; value: string }[];
  applications: string[];
  faq: { q: string; a: string }[];
  relatedDocs?: { title: string; url: string }[];
  intro?: string[];
  image?: ProductImage;
  images?: ProductImage[];
  specNotes?: string[];
  comparison?: ComparisonTable;
  scenarios?: Scenario[];
  maintenance?: string[];
  takeaways?: string[];
}

const {
  title,
  description,
  specTable,
  applications,
  faq,
  relatedDocs = [],
  intro = [],
  image,
  images = [],
  specNotes = [],
  comparison,
  scenarios = [],
  maintenance = [],
  takeaways = []
} = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const lh = (href: string) => localizePath(href, locale);

const galleryImages = images.length > 0 ? images : image ? [image] : [];
const ogImage = galleryImages[0]?.src;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const SITE = "https://dinweysbattery.com";
const pageUrl = Astro.url.pathname;
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${SITE}${pageUrl}#product`,
  "name": title,
  "description": description,
  "image": ogImage ? (ogImage.startsWith("http") ? ogImage : SITE + ogImage) : undefined,
  "url": `${SITE}${pageUrl}`,
  "brand": { "@type": "Brand", "name": "DINWEYS" },
  "manufacturer": { "@id": SITE + "/#manufacturer" },
  "category": "Truck starting battery (SLI)",
  "mainEntityOfPage": { "@id": `${SITE}${pageUrl.replace(/\/$/, "")}/#webpage` },
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Truck OEMs, fleet operators, battery distributors and importers"
  },
  // 价格：GSC「应指定 price 或 priceSpecification.price（在 offers 中）」+ 商家信息同款要求。
  // price 与 priceSpecification 同时给出（两条路径都满足）；
  // 页面规格表显示同一价格（PUBLIC_LIST_PRICE），schema 与可见内容一致。
  "offers": {
    "@type": "Offer",
    "@id": `${SITE}${pageUrl}#offer`,

    "price": PUBLIC_LIST_PRICE.amount,

    "priceCurrency": PUBLIC_LIST_PRICE.currency,

    "priceSpecification": {

      "@type": "UnitPriceSpecification",

      "price": PUBLIC_LIST_PRICE.amount,

      "priceCurrency": PUBLIC_LIST_PRICE.currency

    },
    "url": `${SITE}/contact/`,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "businessFunction": "http://purl.org/goodrelations/v1#Sell",
    "seller": { "@id": SITE + "/#organization" },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "merchantReturnLink": SITE + "/return-policy/"
    }
  }
};

// 站点内产品线（用于内链：相关产品互链）
const productLines = [
  { href: "/products/jis-heavy-duty/", label: "JIS Heavy-Duty (N150/N200)" },
  { href: "/products/din-heavy-duty/", label: "DIN Heavy-Duty (DIN88/DIN100)" },
  { href: "/products/bci-request/", label: "BCI Group 31 / 8D" },
  { href: "/products/24v/", label: "24V Truck Battery Systems" },
  { href: "/products/fleet/", label: "Fleet & OEM Solutions" }
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const siblingLinks = productLines.filter((p) => p.href.replace(/\/$/, "") !== currentPath);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  jsonLd={[productJsonLd, faqJsonLd]}
  pageType="ItemPage"
  breadcrumbs={[
    { name: t(locale, "layout.home"), url: lh("/") },
    { name: "Products", url: "/products/" },
    { name: title, url: pageUrl }
  ]}
>
  <div class="container section">
    <nav aria-label="Breadcrumb" style="font-size:0.9rem;color:#55606e;margin-bottom:16px;">
      <a href={lh("/")} style="color:#1e5aa8;">{t(locale, "layout.home")}</a> &rsaquo;
      <a href="/products/" style="color:#1e5aa8;">Products</a> &rsaquo; {title}
    </nav>
    <h1 style="color:#0f1f3d;margin-bottom:12px;">{title}</h1>
    <p class="lead">{description}</p>

    {takeaways.length > 0 && (
      <div style="margin:20px 0;padding:16px 20px;background:#f4f7fb;border-left:4px solid #f5a623;border-radius:6px;">
        <h2 style="color:#0f1f3d;margin:0 0 10px;">{t(locale, "layout.keyTakeaways")}</h2>
        <ol style="margin:0;padding-left:20px;">
          {takeaways.map((t) => (
            <li style="margin-bottom:6px;">{t}</li>
          ))}
        </ol>
      </div>
    )}

    {galleryImages.length > 0 && (
      <div class={galleryImages.length > 1 ? "product-gallery" : "product-media"}>
        {galleryImages.map((productImage) => (
          <figure class="product-figure">
            <img
              class="product-image"
              src={productImage.src}
              alt={productImage.alt}
              width={productImage.width}
              height={productImage.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{productImage.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {intro.length > 0 && (
      <div style="margin-top:8px;">
        {intro.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    <h2 style="color:#0f1f3d;margin-top:32px;">{t(locale, "layout.specs")}</h2>
    <table>
      <thead>
        <tr><th>{t(locale, "layout.specification")}</th><th>{t(locale, "layout.value")}</th></tr>
      </thead>
      <tbody>
              <tr><td>{t(locale, "layout.indicativePrice")}</td><td>{t(locale, "layout.fromPrice")} {PUBLIC_LIST_PRICE.display} {t(locale, "layout.priceNote")}</td></tr>
        {specTable.map((row) => (
          <tr><td>{row.spec}</td><td>{row.value}</td></tr>
        ))}
      </tbody>
    </table>
    <p class="data-note">
      {t(locale, "layout.repSpecNote")}
    </p>

    {specNotes.length > 0 && (
      <div style="margin-top:28px;">
        <h2 style="color:#0f1f3d;">{t(locale, "layout.understandThese")}</h2>
        {specNotes.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    {comparison && (
      <div style="margin-top:28px;">
        <h2 style="color:#0f1f3d;">{t(locale, "layout.modelComparison")}</h2>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr>
                {comparison.headers.map((h) => (
                  <th>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparison.rows.map((row) => (
                <tr>
                  {row.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <h2 style="color:#0f1f3d;margin-top:32px;">{t(locale, "layout.typicalApps")}</h2>
    <ul>
      {applications.map((a) => (
        <li>{a}</li>
      ))}
    </ul>

    {scenarios.length > 0 && (
      <div style="margin-top:28px;">
        <h2 style="color:#0f1f3d;">{t(locale, "layout.appScenarios")}</h2>
        {scenarios.map((s) => (
          <div style="margin-bottom:16px;">
            <h3 style="color:#0f1f3d;margin-bottom:6px;">{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    )}

    {maintenance.length > 0 && (
      <div style="margin-top:28px;">
        <h2 style="color:#0f1f3d;">{t(locale, "layout.maintenance")}</h2>
        {maintenance.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    <h2 style="color:#0f1f3d;margin-top:32px;">{t(locale, "layout.faq")}</h2>
    {faq.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}

    <div style="margin-top:32px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
      <a class="cta" href="/contact/" style="display:inline-block;background:#f5a623;color:#000;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">Request Datasheet &amp; Quote</a>
      <a class="cta" href="https://wa.me/8613323237275" target="_blank" rel="noopener" style="display:inline-block;background:#25D366;color:#fff;font-weight:700;padding:13px 28px;border-radius:6px;text-decoration:none;">WhatsApp — Contact Now</a>
    </div>

    {siblingLinks.length > 0 && (
      <div style="margin-top:32px;">
        <h2 style="color:#0f1f3d;">{t(locale, "layout.exploreLines")}</h2>
        <ul>
          {siblingLinks.map((s) => (
            <li><a href={s.href} style="color:#1e5aa8;">{s.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    {relatedDocs.length > 0 && (
      <div style="margin-top:32px;padding:20px;background:#f4f7fb;border-radius:8px;">
        <h2 style="color:#0f1f3d;margin-top:0;">{t(locale, "layout.relatedDocs")}</h2>
        <ul style="margin-bottom:0;">
          {relatedDocs.map((d) => (
            <li><a href={d.url} target="_blank" rel="noopener" style="color:#1e5aa8;">{d.title}</a></li>
          ))}
        </ul>
        <p class="data-note" style="margin-top:12px;">{t(locale, "layout.fromKnowledgeHub")} <a href="https://docs.dinweysbattery.com/" target="_blank" rel="noopener">DINWEYS Knowledge Hub</a>.</p>
      </div>
    )}
  </div>
</BaseLayout>
